{%- comment -%}
  Menvel Goods - Video Showcase "See It In Action" (Supports YouTube, Vimeo, MP4 URLs, and Uploaded Shopify Videos)
  File: sections/menvel-video-showcase.liquid
{%- endcomment -%}

<section class="bg-[#191614] text-white relative" role="region" aria-label="See It In Action Video Showcase" data-section-id="{{ section.id }}">
  
  <!-- Full-Width Media Frame -->
  <div class="relative w-full aspect-[16/9] sm:aspect-[21/9] min-h-[300px] max-h-[560px] overflow-hidden flex items-center justify-center bg-black group">
    
    <!-- Cover Poster Image -->
    {%- if section.settings.cover_image != blank -%}
      <img src="{{ section.settings.cover_image | image_url: width: 1800 }}" 
           alt="{{ section.settings.heading | default: 'Menvel Trivet in Action' | escape }}" 
           class="w-full h-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
           id="MenvelVideoPoster"
           loading="lazy">
    {%- else -%}
      <img src="{{ 'menvel-video-pot-banner.jpg' | asset_url }}" 
           alt="Menvel Trivet in Action with Cookware" 
           class="w-full h-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105"
           id="MenvelVideoPoster"
           loading="lazy">
    {%- endif -%}

    <!-- Dark Overlay for Contrast -->
    <div class="absolute inset-0 bg-black/25 pointer-events-none" id="MenvelVideoOverlay"></div>
    
    <!-- Central Interactive Play Button -->
    <button type="button" 
            id="MenvelPlayBtn"
            class="menvel-play-btn absolute z-20 w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/95 hover:bg-white text-[#3A2213] shadow-2xl flex items-center justify-center transition-all duration-300 transform hover:scale-110 cursor-pointer" 
            aria-label="Play video demonstration">
      <svg class="w-7 h-7 sm:w-8 sm:h-8 text-[#3A2213] ml-1" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>

    <!-- Inline Video Container (Plays directly inline on mobile and desktop) -->
    <div id="MenvelInlineVideoContainer" class="hidden absolute inset-0 w-full h-full bg-black z-30 flex items-center justify-center"></div>
  </div>

  <!-- Bottom Dark Accent Bar -->
  <div class="py-6 px-4 bg-[#0E0C0B] text-center border-t border-white/10">
    <h3 class="font-serif text-xl sm:text-2xl font-bold text-white tracking-wide">
      {{ section.settings.heading | default: "See It In Action" }}
    </h3>
    <p class="text-xs sm:text-sm text-neutral-400 mt-1 max-w-xl mx-auto">
      {{ section.settings.subheading | default: "Watch how it effortlessly opens with gravity and protects your table in one smooth motion." }}
    </p>
  </div>

</section>

<script>
  (function() {
    function initVideoShowcase() {
      var playBtn = document.getElementById('MenvelPlayBtn');
      var inlineContainer = document.getElementById('MenvelInlineVideoContainer');
      var poster = document.getElementById('MenvelVideoPoster');
      var overlay = document.getElementById('MenvelVideoOverlay');
      
      if (!playBtn || !inlineContainer) return;

      var youtubeUrl = {{ section.settings.video_url | json }};
      var mp4Url = {{ section.settings.mp4_url | json }};
      var shopifyVideo = {% if section.settings.shopify_video != blank %}{{ section.settings.shopify_video.sources[0].url | json }}{% else %}null{% endif %};

      function buildVideoHtml() {
        if (youtubeUrl && youtubeUrl.trim() !== '') {
          var url = youtubeUrl.trim();
          var vidId = '';
          
          if (url.indexOf('youtu.be/') > -1) {
            vidId = url.split('youtu.be/')[1].split('?')[0].split('&')[0];
          } else if (url.indexOf('watch?v=') > -1) {
            vidId = url.split('watch?v=')[1].split('&')[0];
          } else if (url.indexOf('embed/') > -1) {
            vidId = url.split('embed/')[1].split('?')[0];
          } else if (url.indexOf('vimeo.com/') > -1) {
            var vimeoId = url.split('vimeo.com/')[1].split('?')[0];
            return '<iframe src="https://player.vimeo.com/video/' + vimeoId + '?autoplay=1&playsinline=1" class="w-full h-full border-0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>';
          }
          
          if (vidId) {
            return '<iframe src="https://www.youtube.com/embed/' + vidId + '?autoplay=1&playsinline=1&enablejsapi=1&rel=0&modestbranding=1" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
          }
        }
        if (shopifyVideo) {
          return '<video src="' + shopifyVideo + '" controls autoplay playsinline webkit-playsinline class="w-full h-full object-contain"></video>';
        }
        if (mp4Url && mp4Url.trim() !== '') {
          return '<video src="' + mp4Url.trim() + '" controls autoplay playsinline webkit-playsinline class="w-full h-full object-contain"></video>';
        }
        // Fallback default YouTube player for https://youtu.be/tLxs8QAS00g
        return '<iframe src="https://www.youtube.com/embed/tLxs8QAS00g?autoplay=1&playsinline=1&enablejsapi=1&rel=0&modestbranding=1" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>';
      }

      function handlePlay(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        inlineContainer.innerHTML = buildVideoHtml();
        inlineContainer.classList.remove('hidden');
        playBtn.style.display = 'none';
        if (poster) poster.style.display = 'none';
        if (overlay) overlay.style.display = 'none';

        var vid = inlineContainer.querySelector('video');
        if (vid) {
          var playPromise = vid.play();
          if (playPromise !== undefined) {
            playPromise.catch(function() {
              vid.muted = true;
              vid.play();
            });
          }
        }
      }

      playBtn.addEventListener('click', handlePlay, { passive: false });
      playBtn.addEventListener('touchend', handlePlay, { passive: false });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initVideoShowcase);
    } else {
      initVideoShowcase();
    }
  })();
</script>

{% schema %}
{
  "name": "Video Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See It In Action"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Watch how it effortlessly opens with gravity and protects your table in one smooth motion."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Poster Image"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "YouTube or Vimeo URL",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=tLxs8QAS00g"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Shopify Uploaded Video File"
    },
    {
      "type": "url",
      "id": "mp4_url",
      "label": "External MP4 Video Link"
    }
  ],
  "presets": [
    {
      "name": "Video Showcase"
    }
  ]
}
{% endschema %}
