{%- comment -%}
  Menvel Goods - Video Showcase "See It In Action" (100% Mockup Match)
  File: sections/menvel-video-showcase.liquid
{%- endcomment -%}

<section class="bg-[#191614] text-white" role="region" aria-label="See It In Action Video Showcase">
  
  <!-- Full-Width Media Frame -->
  <div class="relative w-full aspect-[21/9] sm:aspect-[24/9] min-h-[300px] overflow-hidden flex items-center justify-center">
    <img src="{{ 'menvel-video-pot-banner.jpg' | asset_url }}" 
         alt="Menvel Trivet in Action with Cookware" 
         class="w-full h-full object-cover opacity-90 transition-transform duration-700 hover:scale-105"
         loading="lazy">
    
    <!-- Central Interactive Play Button -->
    <button type="button" 
            onclick="window.openMenvelDrawer()" 
            class="menvel-play-btn absolute z-10" 
            aria-label="Play video demonstration">
      <svg class="w-6 h-6 text-[#3A2213] ml-1" fill="currentColor" viewBox="0 0 24 24">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </button>
  </div>

  <!-- Bottom Dark Accent Bar -->
  <div class="py-6 px-4 bg-[#0E0C0B] text-center border-t border-white/10">
    <h3 class="font-serif text-xl sm:text-2xl font-bold text-white tracking-wide">
      See It In Action
    </h3>
    <p class="text-xs sm:text-sm text-neutral-400 mt-1">
      Watch how it effortlessly opens with gravity and protects your table in one smooth motion.
    </p>
  </div>

</section>

{% schema %}
{
  "name": "Menvel Video Showcase",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Menvel Video Showcase"
    }
  ]
}
{% endschema %}
