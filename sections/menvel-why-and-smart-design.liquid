{%- comment -%}
  Menvel Goods - Why Choose Black Walnut Section (100% Mockup Match)
  File: sections/menvel-why-and-smart-design.liquid
{%- endcomment -%}

<section id="MenvelWhy" class="py-16 sm:py-24 bg-white border-b border-[#E8DFD5]" role="region" aria-label="Why Choose Black Walnut">
  <div class="menvel-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Left: White Card with Studio Product Photo -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="w-full max-w-md aspect-square rounded-2xl border border-[#E8DFD5] bg-[#FBF7F2] p-6 shadow-sm flex items-center justify-center">
          <img src="{{ 'menvel-beech-showcase.jpg' | asset_url }}" 
               alt="Menvel Goods Tree Trivet Set" 
               class="w-full h-full object-contain"
               loading="lazy">
        </div>
      </div>

      <!-- Right: Why Choose Content -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <h2 class="menvel-heading-serif text-3xl sm:text-4xl text-[#191614]">
            Why Choose Black Walnut?
          </h2>
          <div class="flex items-center gap-2 mt-2 text-[#3A2213]">
            <span class="w-6 h-0.5 bg-[#3A2213]"></span>
            <span class="text-xs">✦</span>
            <span class="w-6 h-0.5 bg-[#3A2213]"></span>
          </div>
        </div>

        <!-- 3 Feature Bullets with Circular Badges -->
        <div class="space-y-5">
          
          <!-- Bullet 1 -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#3A2213] text-white flex items-center justify-center flex-shrink-0 text-sm shadow-xs mt-0.5">
              ✦
            </div>
            <div>
              <h3 class="font-serif font-bold text-base text-[#191614]">Premium Craftsmanship</h3>
              <p class="text-xs text-[#6B6259] mt-1 leading-relaxed">
                Hand-carved from 100% solid natural hardwood, finished with organic botanical mineral oils to highlight the rich natural grain.
              </p>
            </div>
          </div>

          <!-- Bullet 2 -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#3A2213] text-white flex items-center justify-center flex-shrink-0 text-sm shadow-xs mt-0.5">
              🛡️
            </div>
            <div>
              <h3 class="font-serif font-bold text-base text-[#191614]">Natural Durability</h3>
              <p class="text-xs text-[#6B6259] mt-1 leading-relaxed">
                Naturally heat-resistant up to 450°F and built to last for generations without cracking, scorching, or warping.
              </p>
            </div>
          </div>

          <!-- Bullet 3 -->
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-[#3A2213] text-white flex items-center justify-center flex-shrink-0 text-sm shadow-xs mt-0.5">
              🌲
            </div>
            <div>
              <h3 class="font-serif font-bold text-base text-[#191614]">Space-Saving Art Piece</h3>
              <p class="text-xs text-[#6B6259] mt-1 leading-relaxed">
                Folds into a stunning decorative tree when not in use, adding warmth and Scandinavian beauty to your kitchen countertops.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

