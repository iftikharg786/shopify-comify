<section id="MenvelWhy" class="py-10 sm:py-14 bg-white border-b border-[#E8DFD5]" role="region" aria-label="Why Choose Our Wooden Trivet Set" data-section-id="{{ section.id }}">
  <div class="menvel-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: White Card with Dark Walnut Studio Product Photo -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="w-full max-w-md aspect-square rounded-2xl border border-[#E8DFD5] bg-[#FBF7F2] p-6 shadow-sm flex items-center justify-center">
          <img src="{{ 'menvel-hero-showcase.jpg' | asset_url }}" 
               alt="Menvel Goods Foldable Wooden Trivet Set" 
               class="w-full h-full object-contain"
               loading="lazy">
        </div>
      </div>

      <!-- Right: Content -->
      <div class="lg:col-span-6 space-y-4 text-left">
        <div>
          <span class="menvel-eyebrow text-[#8A4315]">✦ THE NATURAL CHOICE</span>
          <h2 class="menvel-heading-serif text-2xl sm:text-3xl lg:text-4xl text-[#191614] mt-1">
            Why Choose Our Wooden Trivet Set?
          </h2>
          <div class="flex items-center gap-2 mt-2 text-[#3A2213]">
            <span class="w-6 h-0.5 bg-[#3A2213]"></span>
            <span class="text-xs">✦</span>
            <span class="w-6 h-0.5 bg-[#3A2213]"></span>
          </div>
        </div>

        <!-- 3 Feature Bullets with Circular Badges -->
        <div class="space-y-4">
          
          <!-- Bullet 1 -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-full bg-[#3A2213] text-white flex items-center justify-center flex-shrink-0 text-sm shadow-xs mt-0.5">
              ✦
            </div>
            <div>
              <h3 class="font-serif font-bold text-base text-[#191614]">Environmentally Safe</h3>
              <p class="text-xs sm:text-sm text-[#6B6259] mt-0.5 leading-relaxed">
                Crafted from 100% solid natural wood and finished with organic, food-safe protective coating to preserve the rich natural wood grain.
              </p>
            </div>
          </div>

          <!-- Bullet 2 -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-full bg-[#3A2213] text-white flex items-center justify-center flex-shrink-0 text-sm shadow-xs mt-0.5">
              🛡️
            </div>
            <div>
              <h3 class="font-serif font-bold text-base text-[#191614]">Superior Heat Protection</h3>
              <p class="text-xs sm:text-sm text-[#6B6259] mt-0.5 leading-relaxed">
                Naturally heat-resistant up to 450°F to reliably protect your tables and quartz or marble countertops from hot cookware and boiling kettles.
              </p>
            </div>
          </div>

          <!-- Bullet 3 -->
          <div class="flex items-start gap-3.5">
            <div class="w-9 h-9 rounded-full bg-[#3A2213] text-white flex items-center justify-center flex-shrink-0 text-sm shadow-xs mt-0.5">
              🪵
            </div>
            <div>
              <h3 class="font-serif font-bold text-base text-[#191614]">Space-Saving Decorative Tree Stand</h3>
              <p class="text-xs sm:text-sm text-[#6B6259] mt-0.5 leading-relaxed">
                When not in use, store all 4 trivets on the matching upright stand to keep your kitchen tidy while serving as a beautiful conversation piece.
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

