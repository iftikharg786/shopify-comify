{%- comment -%}
  Menvel Goods - Standard Cart Page Section
  File: sections/page-cart.liquid
{%- endcomment -%}

<section class="py-12 sm:py-16 bg-[#FBF7F2]" role="region" aria-label="Shopping Cart">
  <div class="menvel-container max-w-4xl">
    
    <div class="text-center space-y-2 mb-10 pb-6 border-b border-[#E8DFD5]">
      <h1 class="menvel-heading-serif text-3xl sm:text-4xl text-[#191614]">
        Your Shopping Bag
      </h1>
      <p class="text-xs sm:text-sm text-[#6B6259]">Review your items before proceeding to secure checkout.</p>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="/cart" method="post" class="space-y-6">
        <div class="bg-white rounded-2xl border border-[#E8DFD5] p-6 shadow-xs space-y-4">
          {%- for item in cart.items -%}
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-[#E8DFD5] last:border-0 last:pb-0">
              <div class="flex items-center gap-4 w-full sm:w-auto">
                <div class="w-20 h-20 rounded-xl bg-[#FBF7F2] border border-[#E8DFD5] p-1 flex-shrink-0">
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover rounded-lg">
                </div>
                <div>
                  <h3 class="font-serif font-bold text-sm text-[#191614]">{{ item.product.title }}</h3>
                  <p class="text-xs text-[#8A4315] font-semibold mt-0.5">{{ item.variant.title }}</p>
                  <span class="text-xs text-[#6B6259]">{{ item.price | money }} each</span>
                </div>
              </div>

              <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto">
                <div class="flex items-center border border-[#D1D5DB] rounded-lg h-9 bg-white px-2 w-28 justify-between">
                  <input type="number" name="updates[]" id="updates_{{ item.id }}" value="{{ item.quantity }}" min="0" class="w-12 text-center font-bold text-xs text-[#191614] border-none outline-none">
                </div>
                <span class="font-bold text-sm text-[#191614] w-20 text-right">{{ item.line_price | money }}</span>
                <a href="/cart/change?line={{ forloop.index }}&quantity=0" class="text-xs text-neutral-400 hover:text-red-600 transition" aria-label="Remove item">✕</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-white rounded-2xl border border-[#E8DFD5] p-6 shadow-xs">
          <div>
            <span class="text-xs text-[#6B6259] block">Estimated Subtotal</span>
            <span class="font-serif text-2xl font-bold text-[#191614]">{{ cart.total_price | money }} USD</span>
            <p class="text-[11px] text-[#6B6259] mt-0.5">Taxes & shipping calculated at checkout.</p>
          </div>

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <button type="submit" name="update" class="px-5 py-3 rounded-xl border border-[#E8DFD5] bg-white text-xs font-bold text-[#191614] hover:bg-[#FAF7F2] transition">
              UPDATE CART
            </button>
            <button type="submit" name="checkout" class="menvel-btn-primary h-12 px-8 rounded-xl text-xs font-bold uppercase tracking-wider shadow-md">
              <span>PROCEED TO CHECKOUT</span>
            </button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="bg-white rounded-3xl border border-[#E8DFD5] p-10 sm:p-16 text-center space-y-4 shadow-xs">
        <div class="text-4xl">🛍️</div>
        <h2 class="font-serif text-xl font-bold text-[#191614]">Your bag is empty</h2>
        <p class="text-xs text-[#6B6259] max-w-sm mx-auto">Discover our handcrafted solid wood foldable trivets to protect your countertops in style.</p>
        <div class="pt-2">
          <a href="/products/foldable-wooden-trivet-set" class="menvel-btn-primary h-12 px-8 rounded-xl shadow-md">
            <span>SHOP THE COLLECTION</span>
          </a>
        </div>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "settings": []
}
{% endschema %}
