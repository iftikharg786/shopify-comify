{%- comment -%}
  Menvel Goods - Main Header (Desktop + Mobile Responsive Drawer)
  File: sections/menvel-header.liquid
{%- endcomment -%}

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#E8DFD5] transition-all duration-300">
  <div class="menvel-container py-3.5 flex items-center justify-between">
    
    <!-- Mobile Hamburger Toggle -->
    <button type="button" id="MenvelMobileNavOpen" class="md:hidden p-1.5 -ml-1.5 text-[#191614] hover:text-[#3A2213] cursor-pointer" aria-label="Open navigation menu">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>

    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-md bg-[#3A2213] flex items-center justify-center text-white font-serif font-black text-sm tracking-tighter shadow-xs">
        <span class="text-[#D93829]">M</span><span>G</span>
      </div>
      <div class="flex items-baseline gap-1">
        <span class="font-serif text-xl font-bold tracking-tight text-[#191614]">Menvel</span>
        <span class="font-sans text-xl font-medium text-[#D93829]">Goods</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-[13px] font-semibold text-[#191614]">
      <a href="{{ routes.root_url }}" class="hover:text-[#3A2213] transition">Home</a>
      <a href="/products/foldable-wooden-trivet-set" class="hover:text-[#3A2213] transition font-bold text-[#D93829]">Product Page (PDP)</a>
      <a href="/pages/about" class="hover:text-[#3A2213] transition">About Us</a>
      <a href="/pages/contact" class="hover:text-[#3A2213] transition">Contact Us</a>
      <a href="#MenvelMoments" class="hover:text-[#3A2213] transition">Features</a>
      <a href="#MenvelReviews" class="hover:text-[#3A2213] transition">Reviews</a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4 sm:gap-5 text-[#191614]">
      <button type="button" class="hover:text-[#3A2213] transition" aria-label="Search">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </button>
      <button type="button" class="hidden sm:block hover:text-[#3A2213] transition" aria-label="Account">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </button>
      <button type="button" class="js-open-cart-drawer relative hover:text-[#3A2213] transition cursor-pointer" aria-label="Cart">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span class="js-cart-count absolute -top-1.5 -right-2 bg-[#D93829] text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center shadow-xs">
          0
        </span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div id="MenvelMobileNavOverlay" class="menvel-drawer-overlay md:hidden" aria-hidden="true"></div>
<aside id="MenvelMobileNavDrawer" class="menvel-drawer-left md:hidden" aria-modal="true" role="dialog" aria-label="Navigation Menu">
  <div class="p-5 border-b border-[#E8DFD5] flex items-center justify-between bg-[#FBF7F2]">
    <div class="flex items-center gap-2">
      <div class="w-7 h-7 rounded-md bg-[#3A2213] flex items-center justify-center text-white font-serif font-black text-xs">
        <span class="text-[#D93829]">M</span><span>G</span>
      </div>
      <span class="font-serif font-bold text-sm text-[#191614]">Menvel Menu</span>
    </div>
    <button id="MenvelMobileNavClose" type="button" class="p-1.5 rounded-full text-[#6B6259] hover:text-black">
      ✕
    </button>
  </div>
  <nav class="p-6 space-y-4 text-sm font-semibold">
    <a href="{{ routes.root_url }}" class="block py-2 border-b border-[#E8DFD5] text-[#191614]">Home</a>
    <a href="/products/foldable-wooden-trivet-set" class="block py-2 border-b border-[#E8DFD5] text-[#D93829] font-bold">✨ Product Page (PDP)</a>
    <a href="/pages/about" class="block py-2 border-b border-[#E8DFD5] text-[#191614]">About Us</a>
    <a href="/pages/contact" class="block py-2 border-b border-[#E8DFD5] text-[#3A2213] font-bold">Contact Us</a>
    <a href="#MenvelMoments" class="block py-2 border-b border-[#E8DFD5] text-[#191614]">Features</a>
    <a href="#MenvelReviews" class="block py-2 text-[#191614]">Reviews</a>
  </nav>
</aside>

{% schema %}
{
  "name": "Menvel Header",
  "tag": "section",
  "settings": []
}
{% endschema %}
