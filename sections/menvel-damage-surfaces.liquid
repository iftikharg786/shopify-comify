{%- comment -%}
  Menvel Goods - Split Problem & Solution Cards (100% User Images Match)
  File: sections/menvel-damage-surfaces.liquid
{%- endcomment -%}

<section class="py-14 sm:py-20 bg-white border-b border-[#E8DFD5]" role="region" aria-label="Problem and Solution">
  <div class="menvel-container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-stretch">
      
      <!-- Left Card: The Problem -->
      <div class="menvel-split-card flex flex-col justify-between">
        <div class="space-y-3 mb-6">
          <span class="menvel-eyebrow text-[#D93829]">THE PROBLEM</span>
          <h2 class="menvel-heading-serif text-2xl sm:text-3xl text-[#191614] uppercase tracking-wide">
            HOT COOKWARE CAN DAMAGE BEAUTIFUL SURFACES.
          </h2>
          <p class="text-xs sm:text-sm text-[#6B6259] leading-relaxed">
            Direct heat from pans and teapots leaves permanent burn rings, scorch marks, and expensive countertop cracks.
          </p>
        </div>

        <!-- 4 Heat Damage Images with Red ✖ Badges (100% Matching Screenshot) -->
        <div class="pt-6 mt-auto">
          <div class="grid grid-cols-4 gap-2 sm:gap-4 items-center">
            
            <!-- Item 1: Kettle + Burn Ring -->
            <div class="relative flex flex-col items-center group">
              <div class="w-16 h-16 sm:w-22 sm:h-22 md:w-24 md:h-24 rounded-full overflow-hidden border-2 border-white bg-white shadow-md relative">
                <img src="{{ 'menvel-damage-circle-1.jpg' | asset_url }}" 
                     alt="Kettle heat burn damage" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                     loading="lazy">
              </div>
              <span class="absolute bottom-0 right-0 sm:bottom-0.5 sm:right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#B91C1C] text-white flex items-center justify-center text-[10px] sm:text-xs font-black shadow-md border-2 border-white">
                ✕
              </span>
            </div>

            <!-- Item 2: Scorch Ring Closeup -->
            <div class="relative flex flex-col items-center group">
              <div class="w-16 h-16 sm:w-22 sm:h-22 md:w-24 md:h-24 rounded-full overflow-hidden border-2 border-white bg-white shadow-md relative">
                <img src="{{ 'menvel-damage-circle-2.jpg' | asset_url }}" 
                     alt="Scorch ring damage" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                     loading="lazy">
              </div>
              <span class="absolute bottom-0 right-0 sm:bottom-0.5 sm:right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#B91C1C] text-white flex items-center justify-center text-[10px] sm:text-xs font-black shadow-md border-2 border-white">
                ✕
              </span>
            </div>

            <!-- Item 3: Skillet Heat Damage -->
            <div class="relative flex flex-col items-center group">
              <div class="w-16 h-16 sm:w-22 sm:h-22 md:w-24 md:h-24 rounded-full overflow-hidden border-2 border-white bg-white shadow-md relative">
                <img src="{{ 'menvel-damage-circle-3.jpg' | asset_url }}" 
                     alt="Skillet heat damage" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                     loading="lazy">
              </div>
              <span class="absolute bottom-0 right-0 sm:bottom-0.5 sm:right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#B91C1C] text-white flex items-center justify-center text-[10px] sm:text-xs font-black shadow-md border-2 border-white">
                ✕
              </span>
            </div>

            <!-- Item 4: Pot Heat Damage -->
            <div class="relative flex flex-col items-center group">
              <div class="w-16 h-16 sm:w-22 sm:h-22 md:w-24 md:h-24 rounded-full overflow-hidden border-2 border-white bg-white shadow-md relative">
                <img src="{{ 'menvel-damage-circle-4.jpg' | asset_url }}" 
                     alt="Pot surface damage" 
                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" 
                     loading="lazy">
              </div>
              <span class="absolute bottom-0 right-0 sm:bottom-0.5 sm:right-1 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-[#B91C1C] text-white flex items-center justify-center text-[10px] sm:text-xs font-black shadow-md border-2 border-white">
                ✕
              </span>
            </div>

          </div>
        </div>
      </div>

      <!-- Right Card: The Natural Solution -->
      <div class="menvel-split-card flex flex-col justify-between">
        <div class="space-y-3 mb-6">
          <span class="menvel-eyebrow text-[#15803D]">THE BEAUTIFUL, NATURAL SOLUTION</span>
          <h2 class="menvel-heading-serif text-2xl sm:text-3xl text-[#191614]">
            The Smarter Way To Protect Your Table.
          </h2>
          <p class="text-xs sm:text-sm text-[#6B6259] leading-relaxed">
            Handcrafted from premium solid hardwood, our trivets open automatically when placed under hot pots and cookware — saving your counters and tables from permanent heat damage.
          </p>
        </div>

        <!-- High-Res Studio Teapot Featured Image -->
        <div class="rounded-xl overflow-hidden border border-[#E8DFD5] bg-white shadow-xs mt-auto">
          <img src="{{ 'menvel-featured-teapot.jpg' | asset_url }}" 
               alt="Glass Teapot resting on Menvel Wooden Trivet" 
               class="w-full h-64 sm:h-72 object-cover"
               loading="lazy">
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Problem & Solution",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Problem & Solution"
    }
  ]
}
{% endschema %}
