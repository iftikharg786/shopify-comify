{%- comment -%}
  Menvel Goods - 404 Page Not Found Section
  File: sections/main-404.liquid
{%- endcomment -%}

<section class="py-20 sm:py-28 bg-[#FBF7F2] text-center" role="region" aria-label="Page not found">
  <div class="menvel-container max-w-xl mx-auto space-y-6">
    
    <span class="menvel-eyebrow text-[#8A4315]">404 ERROR</span>
    <h1 class="menvel-heading-serif text-4xl sm:text-5xl text-[#191614]">
      Page Not Found
    </h1>
    <p class="text-xs sm:text-sm text-[#6B6259] leading-relaxed">
      The page you are looking for doesn't exist or has been moved. Discover our handcrafted wooden trivets below.
    </p>

    <div class="pt-4 flex items-center justify-center gap-4 flex-wrap">
      <a href="{{ routes.root_url }}" class="menvel-btn-primary h-12 px-8 rounded-xl shadow-md">
        <span>RETURN TO HOME</span>
      </a>
      <a href="/products/foldable-black-walnut-wooden-trivet-set" class="inline-flex items-center justify-center h-12 px-8 rounded-xl border border-[#E8DFD5] bg-white text-[#191614] font-bold text-xs uppercase tracking-wider hover:bg-[#FAF7F2] transition">
        <span>VIEW PRODUCT</span>
      </a>
    </div>

  </div>
</section>

