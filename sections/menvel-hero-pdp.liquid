{%- comment -%}
  Menvel Goods - Hero Showcase (100% Mockup Match)
  File: sections/menvel-hero-pdp.liquid
{%- endcomment -%}

<section id="MenvelHero" class="menvel-hero-wrap py-12 md:py-16 lg:py-20" role="region" aria-label="Serve Beautifully Hero">
  <div class="menvel-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      
      <!-- Left Column: Editorial Headline & Copy -->
      <div class="lg:col-span-6 space-y-5 text-left">
        <span class="menvel-eyebrow text-[#3A2213]">✦ PROTECT YOUR TABLE IN STYLE</span>
        
        <h1 class="menvel-heading-serif text-4xl sm:text-5xl lg:text-6xl text-[#191614] leading-[1.08]">
          Serve Beautifully
        </h1>

        <p class="text-sm sm:text-base text-[#6B6259] leading-relaxed max-w-lg">
          A handcrafted wooden foldable trivet set made from solid wood, designed to protect your table from hot pans, pots, kettles, and dinnerware.
        </p>

        <!-- Wood Finish Selector -->
        <div class="pt-2 space-y-2">
          <span class="text-xs font-bold text-[#191614] block">
            Select Finish: <strong id="SelectedColorLabel" class="text-[#3A2213]">Black Walnut</strong>
          </span>
          
          <div class="flex items-center gap-3">
            <button type="button" 
                    class="menvel-variant-card is-selected flex items-center gap-2 px-3 py-1.5 rounded-full border-2 border-[#3A2213] bg-white text-xs font-bold text-[#191614] shadow-xs cursor-pointer"
                    data-variant-name="Black Walnut"
                    data-variant-img="{{ 'menvel-hero-showcase.jpg' | asset_url }}"
                    data-variant-id="1">
              <span class="w-3.5 h-3.5 rounded-full bg-[#3A2213]"></span>
              <span>Black Walnut</span>
            </button>

            <button type="button" 
                    class="menvel-variant-card flex items-center gap-2 px-3 py-1.5 rounded-full border border-[#E8DFD5] bg-white text-xs font-bold text-[#191614] shadow-xs cursor-pointer hover:border-[#3A2213]"
                    data-variant-name="Natural Beech"
                    data-variant-img="{{ 'menvel-beech-showcase.jpg' | asset_url }}"
                    data-variant-id="2">
              <span class="w-3.5 h-3.5 rounded-full bg-[#E2BA9A]"></span>
              <span>Natural Beech</span>
            </button>
          </div>
        </div>

        <!-- Action Button & Price -->
        <div class="pt-3 flex items-center gap-4 flex-wrap">
          <a href="/products/foldable-wooden-trivet-set" 
             class="menvel-btn-primary h-12 px-8 rounded-lg shadow-md text-xs font-extrabold uppercase tracking-wider">
            <span>SHOP NOW — $18.99</span>
          </a>
          
          <span class="text-xs text-[#6B6259] font-medium flex items-center gap-1">
            <span class="text-[#15803D] font-bold">✓</span> Free U.S. Shipping Included
          </span>
        </div>

      </div>

      <!-- Right Column: High-Res Master Lifestyle Imagery -->
      <div class="lg:col-span-6 flex justify-center">
        <div class="relative w-full max-w-lg aspect-square rounded-2xl overflow-hidden bg-transparent flex items-center justify-center">
          <img id="MenvelMainImage" 
               src="{{ 'menvel-hero-showcase.jpg' | asset_url }}" 
               alt="Menvel Tree Trivet Set on Table" 
               class="w-full h-full object-contain transform transition-all duration-300 hover:scale-105"
               loading="eager">
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menvel Hero Section",
  "tag": "section",
  "settings": []
}
{% endschema %}
