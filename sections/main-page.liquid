{%- comment -%}
  Menvel Goods - Standard Default Page Section
  File: sections/main-page.liquid
{%- endcomment -%}

<section class="py-12 sm:py-16 bg-white" role="region" aria-label="{{ page.title | escape }}">
  <div class="menvel-container max-w-4xl">
    
    <div class="text-center space-y-3 mb-10 pb-8 border-b border-[#E8DFD5]">
      <h1 class="menvel-heading-serif text-3xl sm:text-4xl lg:text-5xl text-[#191614]">
        {{ page.title }}
      </h1>
      <div class="w-12 h-0.5 bg-[#3A2213] mx-auto mt-3 rounded-full"></div>
    </div>

    <div class="prose max-w-none text-xs sm:text-sm text-[#6B6259] leading-relaxed space-y-4">
      {{ page.content }}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Page Content",
  "tag": "section",
  "settings": []
}
{% endschema %}
