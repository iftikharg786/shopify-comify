{%- comment -%}
  Single Product: Specifications Section
  File: sections/menvel-specs.liquid
{%- endcomment -%}

<section class="menvel-specs py-16 sm:py-24 bg-[#F8F2E9] border-b border-[#EADFCF]">
  <div class="menvel-container">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="menvel-eyebrow">Precision Engineering</span>
      <h2 class="menvel-heading-lg text-[#1F1B17]">
        Technical Specifications.
      </h2>
      <p class="menvel-lead mt-4 text-[#655E56]">
        Every millimeter is calculated to ensure balanced weight distribution, silky smooth joint articulation, and lasting durability.
      </p>
    </div>

    <!-- 2 Column Specifications Box -->
    <div class="max-w-4xl mx-auto bg-white rounded-2xl border border-[#EADFCF] shadow-sm p-6 sm:p-10">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-6 text-sm">
        
        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Brand</span>
          <span class="font-bold text-[#1F1B17]">Menvel Goods</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Model Number</span>
          <span class="font-bold text-[#1F1B17]">BD-001</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Material</span>
          <span class="font-bold text-[#1F1B17]">100% Solid Natural Black Walnut</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Finish / Finish Color</span>
          <span class="font-bold text-[#1F1B17]">Natural Black Walnut Finish</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Stored Tree Dimensions</span>
          <span class="font-bold text-[#1F1B17]">4" L × 4" W × 9" H (Compact)</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Unfolded Trivet Span</span>
          <span class="font-bold text-[#1F1B17]">8.0 Inches (20.3 cm)</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Total Trivets Included</span>
          <span class="font-bold text-[#1F1B17]">4 × Foldable Trivets</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Display Stand</span>
          <span class="font-bold text-[#1F1B17]">1 × Weighted Tree Base</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Max Temperature Rating</span>
          <span class="font-bold text-[#15803D]">Up to 450°F (232°C)</span>
        </div>

        <div class="flex justify-between py-3 border-b border-[#EADFCF]">
          <span class="font-bold text-[#655E56]">Packaging</span>
          <span class="font-bold text-[#1F1B17]">Custom Gold-Foil Gift Box</span>
        </div>

      </div>

      <!-- Care Instructions Notice -->
      <div class="mt-8 p-4 rounded-xl bg-[#F8F2E9] border border-[#EADFCF] text-xs text-[#655E56] flex items-start gap-3">
        <span class="text-base text-[#8A5428]">💡</span>
        <span>
          <strong>Simple Wood Care:</strong> Wipe clean with a damp cloth and mild soap. Periodically condition with food-grade mineral or walnut oil to maintain the deep, rich luster for generations. Do not submerge in water or place in the dishwasher.
        </span>
      </div>
    </div>

  </div>
</section>

