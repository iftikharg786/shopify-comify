{%- comment -%}
  Menvel Goods - Master Footer (Balanced 3-Column Layout & Compact Spacing)
  File: sections/menvel-footer.liquid
{%- endcomment -%}

{%- assign footer_menu = linklists[section.settings.footer_menu] | default: linklists['footer'] -%}
{%- assign customer_menu = linklists[section.settings.customer_menu] | default: linklists['customer-services'] -%}

<footer id="MenvelFooter" class="bg-[#FBF7F2] pt-10 pb-6 border-t border-[#E8DFD5]" role="contentinfo" aria-label="Site Footer" data-section-id="{{ section.id }}">
  <div class="menvel-container">
    
    <!-- 3 Clean Columns: Brand (Col 1-2), Quick Links (Col 3), Customer Services (Col 4) -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 mb-8 items-start">
      
      <!-- Column 1: Brand & Newsletter (Wider Column) -->
      <div class="md:col-span-6 lg:col-span-5 space-y-3.5 text-left">
        <a href="{{ routes.root_url }}" class="inline-flex items-center gap-2.5">
          {%- if section.settings.footer_logo != blank -%}
            <img src="{{ section.settings.footer_logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" style="max-width: {{ section.settings.footer_logo_width | default: 200 }}px;" class="h-auto w-full">
          {%- else -%}
            <div class="w-8 h-8 rounded-md bg-[#3A2213] flex items-center justify-center text-white font-serif font-black text-sm tracking-tighter shadow-xs">
              <span class="text-[#D93829]">M</span><span>G</span>
            </div>
            <div class="flex items-baseline gap-1">
              <span class="font-serif text-xl font-bold tracking-tight text-[#191614]">{{ section.settings.brand_title | default: "Menvel" }}</span>
              <span class="font-sans text-xl font-medium text-[#D93829]">{{ section.settings.brand_subtitle | default: "Goods" }}</span>
            </div>
          {%- endif -%}
        </a>

        <p class="text-xs text-[#6B6259] leading-relaxed max-w-sm">
          {{ section.settings.about_text | default: "Thoughtfully crafted wooden essentials designed to bring beauty and practical surface protection to your home." }}
        </p>

        <!-- Newsletter Subscription Form -->
        {%- if section.settings.enable_newsletter -%}
          {% form 'customer', class: 'flex items-center gap-1.5 pt-0.5 max-w-sm' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <input type="email" 
                   name="contact[email]"
                   placeholder="Your email address..." 
                   required
                   class="flex-1 px-3 py-2 text-xs bg-white border border-[#E8DFD5] rounded-md outline-none focus:border-[#3A2213] text-[#191614]">
            <button type="submit" 
                    class="w-8 h-8 rounded-md bg-[#3A2213] text-white flex items-center justify-center hover:bg-[#2A170C] transition flex-shrink-0 cursor-pointer" 
                    aria-label="Subscribe">
              ➔
            </button>
          {% endform %}
        {%- endif -%}

        <!-- Social Icons -->
        <div class="flex items-center gap-2.5 pt-1">
          <!-- Facebook -->
          <a href="{{ section.settings.facebook_url | default: 'https://www.facebook.com/profile.php?id=61592727556438&mibextid=wwXIfr' }}" class="menvel-social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd"/>
            </svg>
          </a>
          <!-- Instagram -->
          <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/menvel.goods?igsi=aDIwMjliOGYyaDI4' }}" class="menvel-social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/>
            </svg>
          </a>
          <!-- Pinterest -->
          <a href="{{ section.settings.pinterest_url | default: '#' }}" class="menvel-social-link" aria-label="Pinterest" target="_blank" rel="noopener">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/>
            </svg>
          </a>
          <!-- TikTok -->
          <a href="{{ section.settings.tiktok_url | default: 'https://www.tiktok.com/@menvel.goods' }}" class="menvel-social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="md:col-span-3 lg:col-span-3 lg:col-start-7 space-y-2.5 text-left">
        <h4 class="font-bold text-xs text-[#191614] uppercase tracking-wider">
          {{ section.settings.menu_1_heading | default: "QUICK LINKS" }}
        </h4>
        <ul class="space-y-1.5 text-xs text-[#6B6259]">
          {%- if footer_menu.links.size > 0 -%}
            {%- for link in footer_menu.links -%}
              <li><a href="{{ link.url }}" class="hover:text-[#3A2213] transition">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.root_url }}" class="hover:text-[#3A2213] transition">Home</a></li>
            <li><a href="/products/foldable-black-walnut-wooden-trivet-set" class="hover:text-[#3A2213] transition">Shop Trivet Set</a></li>
            <li><a href="/pages/about-us" class="hover:text-[#3A2213] transition">About Us</a></li>
            <li><a href="/pages/contact" class="hover:text-[#3A2213] transition">Contact Us</a></li>
            <li><a href="/pages/faq" class="hover:text-[#3A2213] transition">FAQs</a></li>
          {%- endif -%}
        </ul>
      </div>

      <!-- Column 3: Customer Services -->
      <div class="md:col-span-3 lg:col-span-3 space-y-2.5 text-left">
        <h4 class="font-bold text-xs text-[#191614] uppercase tracking-wider">
          {{ section.settings.menu_2_heading | default: "CUSTOMER SERVICES" }}
        </h4>
        <ul class="space-y-1.5 text-xs text-[#6B6259]">
          {%- if customer_menu.links.size > 0 -%}
            {%- for link in customer_menu.links -%}
              <li><a href="{{ link.url }}" class="hover:text-[#3A2213] transition">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/shipping-policy" class="hover:text-[#3A2213] transition">Shipping Policy</a></li>
            <li><a href="/pages/refund-policy" class="hover:text-[#3A2213] transition">Returns & Refunds</a></li>
            <li><a href="/pages/privacy-policy" class="hover:text-[#3A2213] transition">Privacy Policy</a></li>
            <li><a href="/pages/terms-of-service" class="hover:text-[#3A2213] transition">Terms of Service</a></li>
            <li><a href="/pages/contact" class="hover:text-[#3A2213] transition">Help & Support</a></li>
          {%- endif -%}
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright Centered Single Line -->
    <div class="pt-5 border-t border-[#E8DFD5] text-center text-[11px] text-[#6B6259]">
      <p class="whitespace-nowrap overflow-x-auto py-1">© {{ 'now' | date: '%Y' }} menvelgoods. All rights reserved. | Developed by <a href="https://adsolutions.us/" target="_blank" rel="noopener" class="underline hover:text-[#3A2213] transition font-medium">Adsolutions Pvt Ltd</a></p>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "range",
      "id": "footer_logo_width",
      "min": 80,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Footer Logo Width",
      "default": 200
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "Menvel"
    },
    {
      "type": "text",
      "id": "brand_subtitle",
      "label": "Brand Subtitle",
      "default": "Goods"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Thoughtfully crafted wooden essentials designed to bring beauty and practical surface protection to your home."
    },
    {
      "type": "checkbox",
      "id": "enable_newsletter",
      "label": "Enable Newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Menu 1 Heading",
      "default": "QUICK LINKS"
    },
    {
      "type": "link_list",
      "id": "footer_menu",
      "label": "Quick Links Menu"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Menu 2 Heading",
      "default": "CUSTOMER SERVICES"
    },
    {
      "type": "link_list",
      "id": "customer_menu",
      "label": "Customer Services Menu"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
