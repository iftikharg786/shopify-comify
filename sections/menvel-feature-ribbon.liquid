{%- comment -%}
  Menvel Goods - 4 Feature Icon Badges (Compact Spacing)
  File: sections/menvel-feature-ribbon.liquid
{%- endcomment -%}

<section class="py-10 bg-[#FBF7F2] border-b border-[#E8DFD5]" role="region" aria-label="Key Product Features" data-section-id="{{ section.id }}">
  <div class="menvel-container">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">

      <!-- Feature 1: Environmentally Safe -->
      <div class="flex flex-col items-center gap-2.5">
        <div class="menvel-icon-badge-box">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C8 2 5 5.5 5 9c0 3 1.5 5.5 4 7v3h6v-3c2.5-1.5 4-4 4-7 0-3.5-3-7-7-7z"/>
            <path d="M9 20h6"/>
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-base text-[#191614] leading-tight mb-1">
            {{ section.settings.feat1_title | default: "Made with Quality in Mind" }}
          </h4>
          <p class="text-xs text-[#6B6259] leading-relaxed max-w-[180px] mx-auto">
            {{ section.settings.feat1_text | default: "Crafted from carefully selected solid natural wood." }}
          </p>
        </div>
      </div>

      <!-- Feature 2: Automatic Gravity Open -->
      <div class="flex flex-col items-center gap-2.5">
        <div class="menvel-icon-badge-box">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 8v4l3 3"/>
            <path d="M8 12H4m4-4l-3-3"/>
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-base text-[#191614] leading-tight mb-1">
            {{ section.settings.feat2_title | default: "Gravity Opens Automatically" }}
          </h4>
          <p class="text-xs text-[#6B6259] leading-relaxed max-w-[180px] mx-auto">
            {{ section.settings.feat2_text | default: "Opens with gravity when cookware is placed on top." }}
          </p>
        </div>
      </div>

      <!-- Feature 3: Space-Saving Tree Shape -->
      <div class="flex flex-col items-center gap-2.5">
        <div class="menvel-icon-badge-box">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2L5 9h4l-3 5h4l-3 5h10l-3-5h4L14 9h4L12 2z"/>
            <rect x="11" y="19" width="2" height="3" rx="1"/>
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-base text-[#191614] leading-tight mb-1">
            {{ section.settings.feat3_title | default: "Space-Saving Tree Form" }}
          </h4>
          <p class="text-xs text-[#6B6259] leading-relaxed max-w-[180px] mx-auto">
            {{ section.settings.feat3_text | default: "Stores upright as a decorative tree sculpture on your countertop." }}
          </p>
        </div>
      </div>

      <!-- Feature 4: Gift-Ready Box -->
      <div class="flex flex-col items-center gap-2.5">
        <div class="menvel-icon-badge-box">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="9" width="18" height="13" rx="2"/>
            <path d="M3 9h18M12 9V22"/>
            <path d="M12 9C12 9 8 7 8 5a2 2 0 014 0"/>
            <path d="M12 9c0 0 4-2 4-4a2 2 0 00-4 0"/>
            <rect x="2" y="6" width="20" height="3" rx="1"/>
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-base text-[#191614] leading-tight mb-1">
            {{ section.settings.feat4_title | default: "Gift-Ready Luxury Box" }}
          </h4>
          <p class="text-xs text-[#6B6259] leading-relaxed max-w-[180px] mx-auto">
            {{ section.settings.feat4_text | default: "Packed in a gold-embossed premium presentation gift box." }}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menvel Feature Badges",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "feat1_title", "label": "Feature 1 Title", "default": "Natural Solid Wood" },
    { "type": "text", "id": "feat1_text",  "label": "Feature 1 Text",  "default": "Environmentally safe, 100% natural solid wood." },
    { "type": "text", "id": "feat2_title", "label": "Feature 2 Title", "default": "Gravity Opens Automatically" },
    { "type": "text", "id": "feat2_text",  "label": "Feature 2 Text",  "default": "Opens with gravity when cookware is placed on top." },
    { "type": "text", "id": "feat3_title", "label": "Feature 3 Title", "default": "Space-Saving Tree Form" },
    { "type": "text", "id": "feat3_text",  "label": "Feature 3 Text",  "default": "Stores upright as a decorative tree sculpture on your countertop." },
    { "type": "text", "id": "feat4_title", "label": "Feature 4 Title", "default": "Gift-Ready Luxury Box" },
    { "type": "text", "id": "feat4_text",  "label": "Feature 4 Text",  "default": "Packed in a gold-embossed premium presentation gift box." }
  ],
  "presets": [
    { "name": "Menvel Feature Badges" }
  ]
}
{% endschema %}
