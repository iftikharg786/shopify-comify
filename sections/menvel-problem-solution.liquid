{%- comment -%}
  Single Product: Problem & Solution Section with Exact Infographic
  File: sections/menvel-problem-solution.liquid
{%- endcomment -%}

<section id="MenvelProblem" class="menvel-problem-solution py-16 sm:py-24 bg-[#F8F2E9] border-b border-[#EADFCF]">
  <div class="menvel-container">
    
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="menvel-eyebrow">The Cost of Unprotected Surfaces</span>
      <h2 class="menvel-heading-lg text-[#1F1B17]">
        Heat Damage Happens Fast.
      </h2>
      <p class="menvel-lead mt-4 text-[#655E56]">
        Hot cookware leaves irreversible burn rings and cracks on tables and countertops. Protect your investment with a solid hardwood heat barrier.
      </p>
    </div>

    <!-- 2-Column: Exact Product Infographic on Left + Deep Breakdown on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center max-w-6xl mx-auto">
      
      <!-- Left: Real Comparison Infographic Image -->
      <div class="lg:col-span-6">
        <div class="rounded-3xl overflow-hidden border border-[#EADFCF] shadow-xl bg-white aspect-square">
          <img src="{{ 'menvel-problem-solution.jpg' | asset_url }}" 
               alt="Without a Trivet vs With Our Wooden Trivet" 
               class="w-full h-full object-cover" 
               loading="lazy">
        </div>
      </div>

      <!-- Right: Detailed Problem / Solution Callouts -->
      <div class="lg:col-span-6 space-y-6">
        
        <!-- Without Trivet Danger Box -->
        <div class="p-6 rounded-2xl bg-white border border-red-200 shadow-sm space-y-3">
          <div class="flex items-center gap-2 text-red-600 font-bold text-sm uppercase tracking-wider">
            <span>👎</span>
            <span>Without A Trivet</span>
          </div>
          <h3 class="font-serif text-xl font-bold text-[#1F1B17]">Heat Damage To Your Table</h3>
          <p class="text-xs text-[#655E56] leading-relaxed">
            Hot kettles, skillets, and soup pots can leave scorching marks, thermal clouding, and permanent finish damage within seconds of contact.
          </p>
        </div>

        <!-- With Menvel Trivet Guard Box -->
        <div class="p-6 rounded-2xl bg-[#55331F] text-[#F8F2E9] border border-[#3d2314] shadow-lg space-y-3">
          <div class="flex items-center gap-2 text-[#D97706] font-bold text-sm uppercase tracking-wider">
            <span>👍</span>
            <span>With Our Wooden Trivet</span>
          </div>
          <h3 class="font-serif text-xl font-bold text-white">Protects Your Tabletop Intact</h3>
          <p class="text-xs text-neutral-300 leading-relaxed">
            Creates an elevated natural thermal shield between burning hot cookware and delicate surfaces, completely preventing scorch rings.
          </p>
          <div class="pt-3">
            <a href="#MenvelBuySection" class="inline-flex items-center gap-2 text-xs font-bold text-[#D97706] hover:underline js-scroll-to-buy">
              <span>Protect your surfaces now →</span>
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

