</section>

<script>
  (function() {
    function initReviewsSlider() {
      var track = document.getElementById('MenvelReviewsTrack');
      var prev = document.getElementById('ReviewsPrevBtn');
      var next = document.getElementById('ReviewsNextBtn');
      var dots = document.querySelectorAll('.review-dot');

      if (!track || !prev || !next) return;

      var cardWidth = 320;

      prev.onclick = function() {
        track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      };

      next.onclick = function() {
        track.scrollBy({ left: cardWidth, behavior: 'smooth' });
      };

      dots.forEach(function(dot) {
        dot.onclick = function() {
          var idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          track.scrollTo({ left: idx * cardWidth, behavior: 'smooth' });
        };
      });

      track.addEventListener('scroll', function() {
        var activeIdx = Math.round(track.scrollLeft / cardWidth);
        dots.forEach(function(d, i) {
          if (i === activeIdx) {
            d.className = 'w-2.5 h-2.5 rounded-full bg-[#3A2213] review-dot';
          } else {
            d.className = 'w-2 h-2 rounded-full bg-[#E8DFD5] review-dot';
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initReviewsSlider);
    } else {
      initReviewsSlider();
    }
  })();
</script>

