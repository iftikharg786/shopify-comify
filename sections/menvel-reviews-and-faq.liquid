                id="ReviewsNextBtn" 
                class="w-8 h-8 rounded-full border border-[#E8DFD5] bg-white flex items-center justify-center text-xs text-[#191614] hover:bg-[#FBF7F2] shadow-2xs transition cursor-pointer" 
