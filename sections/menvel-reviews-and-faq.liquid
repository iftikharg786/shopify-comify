{%- comment -%}
  Menvel Goods - Customer Reviews Section (100% Mockup Match)
  File: sections/menvel-reviews-and-faq.liquid
{%- endcomment -%}

<section id="MenvelReviews" class="py-16 sm:py-24 bg-white border-b border-[#E8DFD5]" role="region" aria-label="Customer Reviews">
  <div class="menvel-container text-center">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto mb-12">
      <span class="menvel-eyebrow text-[#3A2213]">CUSTOMER REVIEWS</span>
      <h2 class="menvel-heading-serif text-3xl sm:text-4xl text-[#191614] mt-2">
        Loved For Every Detail
      </h2>
      <p class="text-xs sm:text-sm text-[#6B6259] mt-2">
        See why home chefs and entertainers are calling this the most practical piece of kitchen decor.
      </p>
    </div>

    <!-- 3 Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      
      <!-- Review 1 -->
      <div class="menvel-review-card">
        <div>
          <div class="flex text-[#D97706] text-xs mb-3">★★★★★</div>
          <p class="text-xs sm:text-sm text-[#191614] leading-relaxed italic">
            "An absolute work of art on our kitchen island! The wood quality is unbelievable and the gravity open mechanism always impresses our dinner guests."
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#E8DFD5]">
          <h4 class="font-serif font-bold text-xs text-[#191614]">Sarah M.</h4>
          <span class="text-[10px] text-[#15803D] font-semibold">✓ Verified Buyer</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="menvel-review-card">
        <div>
          <div class="flex text-[#D97706] text-xs mb-3">★★★★★</div>
          <p class="text-xs sm:text-sm text-[#191614] leading-relaxed italic">
            "The quality is top tier. I bought one for myself and three more as housewarming gifts. Everyone loves how functional and pretty it is on the table."
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#E8DFD5]">
          <h4 class="font-serif font-bold text-xs text-[#191614]">David R.</h4>
          <span class="text-[10px] text-[#15803D] font-semibold">✓ Verified Buyer</span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="menvel-review-card">
        <div>
          <div class="flex text-[#D97706] text-xs mb-3">★★★★★</div>
          <p class="text-xs sm:text-sm text-[#191614] leading-relaxed italic">
            "Finally a trivet that doesn't need to be hidden away in a crowded drawer. It stays on my countertop 24/7 as beautiful wood decor."
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-[#E8DFD5]">
          <h4 class="font-serif font-bold text-xs text-[#191614]">Elena K.</h4>
          <span class="text-[10px] text-[#15803D] font-semibold">✓ Verified Buyer</span>
        </div>
      </div>

    </div>

    <!-- Carousel Controls -->
    <div class="flex items-center justify-center gap-3 mt-8">
      <button type="button" class="w-8 h-8 rounded-full border border-[#E8DFD5] bg-white flex items-center justify-center text-xs text-[#191614] hover:bg-[#FBF7F2] transition" aria-label="Previous review">
        ‹
      </button>
      <span class="w-2 h-2 rounded-full bg-[#3A2213]"></span>
      <span class="w-2 h-2 rounded-full bg-[#E8DFD5]"></span>
      <span class="w-2 h-2 rounded-full bg-[#E8DFD5]"></span>
      <button type="button" class="w-8 h-8 rounded-full border border-[#E8DFD5] bg-white flex items-center justify-center text-xs text-[#191614] hover:bg-[#FBF7F2] transition" aria-label="Next review">
        ›
      </button>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Menvel Reviews Section",
  "tag": "section",
  "settings": []
}
{% endschema %}
