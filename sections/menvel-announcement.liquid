{%- comment -%}
  Menvel Goods - Top Announcement Bar (100% Dynamic Shopify Schema)
  File: sections/menvel-announcement.liquid
{%- endcomment -%}

{%- if section.settings.enable_announcement -%}
<div class="bg-[#0B2820] text-[#E5ECE9] py-2 px-4 text-[11px] font-semibold tracking-wider border-b border-[#071E18] relative z-20" data-section-id="{{ section.id }}">
  <div class="menvel-container flex items-center justify-between flex-wrap gap-2 text-center sm:text-left">
    
    <!-- Left: Star Rating -->
    <div class="flex items-center gap-1.5 justify-center sm:justify-start">
      <span class="text-[#D97706] text-xs">★★★★★</span>
      <span class="font-bold text-white">{{ section.settings.rating_score | default: "4.9/5" }}</span>
      <span class="text-white/70">{{ section.settings.reviews_count | default: "OVER 1,200+ REVIEWS" }}</span>
    </div>

    <!-- Center: Guarantee & Free Shipping -->
    <div class="hidden md:flex items-center gap-2 text-white/90">
      <span>{{ section.settings.shipping_text | default: "FREE US SHIPPING OVER $50" }}</span>
      <span class="text-white/40">•</span>
      <span>{{ section.settings.guarantee_text | default: "30-DAY MONEY-BACK GUARANTEE" }}</span>
    </div>

    <!-- Right: Highlight / Badge -->
    <div class="flex items-center gap-3 justify-center sm:justify-end text-white/80">
      <span>{{ section.settings.right_text | default: "📦 SHIPS IN 24H" }}</span>
    </div>

  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4.9/5"
    },
    {
      "type": "text",
      "id": "reviews_count",
      "label": "Reviews Text",
      "default": "OVER 1,200+ REVIEWS"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping Text",
      "default": "FREE US SHIPPING OVER $50"
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Guarantee Text",
      "default": "30-DAY MONEY-BACK GUARANTEE"
    },
    {
      "type": "text",
      "id": "right_text",
      "label": "Right Highlight",
      "default": "📦 SHIPS IN 24H"
    }
  ]
}
{% endschema %}
