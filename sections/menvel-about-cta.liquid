{%- comment -%}
  Menvel Goods - About Us Conversion CTA Section
  File: sections/menvel-about-cta.liquid
{%- endcomment -%}

<section class="py-16 sm:py-24 bg-white" role="region" aria-label="Shop Menvel Goods">
  <div class="menvel-container">
    
    <div class="rounded-3xl bg-[#241710] text-white p-8 sm:p-12 lg:p-16 shadow-lg relative overflow-hidden">
      <!-- Background Texture Effect -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-white/5 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
        
        <div class="lg:col-span-7 space-y-5 text-left">
          <span class="menvel-eyebrow text-[#D97706]">ELEVATE YOUR KITCHEN TODAY</span>
          <h2 class="menvel-heading-serif text-3xl sm:text-4xl lg:text-5xl text-white leading-tight">
            Protect Your Table.<br>Serve Beautifully.
          </h2>
          <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed max-w-xl">
            Experience the original handcrafted Foldable Wooden Trivet Set. Includes 4 solid wood foldable trivets and a matching decorative tree display stand.
          </p>

          <div class="pt-3 flex items-center gap-4 flex-wrap">
            <a href="product.html" 
               class="inline-flex items-center justify-center h-12 px-8 rounded-xl bg-white hover:bg-[#FAF7F2] text-[#191614] font-black text-xs uppercase tracking-wider shadow-lg transition-all duration-200 transform hover:-translate-y-0.5">
              <span>SHOP THE COLLECTION — $18.99</span>
            </a>

            <span class="text-xs text-neutral-300 font-medium flex items-center gap-1.5">
              <span class="text-[#22C55E] font-bold">✓</span> 30-Day Money-Back Guarantee
            </span>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center">
          <div class="w-full max-w-sm aspect-square rounded-2xl overflow-hidden bg-white/10 p-4 border border-white/15 backdrop-blur-xs flex items-center justify-center">
            <img src="{{ 'menvel-pdp-main-hero.jpg' | asset_url }}" 
                 alt="Foldable Wooden Trivet Set" 
                 class="w-full h-full object-contain hover:scale-105 transition-transform duration-500"
                 loading="lazy">
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

{% schema %}
