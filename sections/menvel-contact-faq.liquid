{%- comment -%}
  Menvel Goods - Contact Page Quick FAQ Section (100% Dynamic Shopify Schema)
  File: sections/menvel-contact-faq.liquid
{%- endcomment -%}

<section class="py-14 sm:py-20 bg-[#FBF7F2] border-b border-[#E8DFD5]" role="region" aria-label="Frequently Asked Questions" data-section-id="{{ section.id }}">
  <div class="menvel-container max-w-4xl">
    
    <div class="text-center space-y-2 mb-12">
      <span class="menvel-eyebrow text-[#8A4315]">{{ section.settings.eyebrow | default: "COMMON QUESTIONS" }}</span>
      <h2 class="menvel-heading-serif text-2xl sm:text-3xl text-[#191614]">
        {{ section.settings.heading | default: "Frequently Asked Questions" }}
      </h2>
      <p class="text-xs sm:text-sm text-[#6B6259]">
        {{ section.settings.subheading | default: "Quick answers to common questions about our products and orders." }}
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-3">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="rounded-2xl border border-[#E8DFD5] bg-white overflow-hidden shadow-xs" {{ block.shopify_attributes }}>
            <button type="button" class="js-pdp-accordion-header w-full p-5 flex items-center justify-between font-bold text-xs sm:text-sm text-[#191614] text-left hover:bg-[#FAF7F2] transition cursor-pointer">
              <span>{{ block.settings.question }}</span>
              <svg class="w-4 h-4 transform transition-transform duration-300 {% if forloop.first %}rotate-180{% endif %} flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="js-pdp-accordion-content {% unless forloop.first %}hidden{% endunless %} p-5 pt-0 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
              <div class="pt-3 prose text-xs text-[#6B6259]">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Default Fallback Accordions -->
        <div class="rounded-2xl border border-[#E8DFD5] bg-white overflow-hidden shadow-xs">
          <button type="button" class="js-pdp-accordion-header w-full p-5 flex items-center justify-between font-bold text-xs sm:text-sm text-[#191614] text-left hover:bg-[#FAF7F2] transition cursor-pointer">
            <span>How do I clean and care for my wooden trivet set?</span>
            <svg class="w-4 h-4 transform transition-transform duration-300 rotate-180 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="js-pdp-accordion-content p-5 pt-0 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
            <p class="pt-3">
              Simply wipe clean with a soft, slightly damp cloth after use. Do not submerge in water or place in the dishwasher. To keep the wood looking rich and vibrant for years, you can apply a drop of food-safe mineral oil or cutting board wax once or twice a year.
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-[#E8DFD5] bg-white overflow-hidden shadow-xs">
          <button type="button" class="js-pdp-accordion-header w-full p-5 flex items-center justify-between font-bold text-xs sm:text-sm text-[#191614] text-left hover:bg-[#FAF7F2] transition cursor-pointer">
            <span>What is the maximum heat resistance?</span>
            <svg class="w-4 h-4 transform transition-transform duration-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="js-pdp-accordion-content hidden p-5 pt-0 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
            <p class="pt-3">
              Our solid natural wood trivets are naturally heat-resistant up to 450°F (232°C). They safely handle cast iron skillets, boiling kettles, Dutch ovens, and sizzling casserole dishes straight off the stove or oven.
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-[#E8DFD5] bg-white overflow-hidden shadow-xs">
          <button type="button" class="js-pdp-accordion-header w-full p-5 flex items-center justify-between font-bold text-xs sm:text-sm text-[#191614] text-left hover:bg-[#FAF7F2] transition cursor-pointer">
            <span>How long does shipping take?</span>
            <svg class="w-4 h-4 transform transition-transform duration-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="js-pdp-accordion-content hidden p-5 pt-0 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
            <p class="pt-3">
              Orders are fulfilled through Amazon’s fulfillment network. Eligible U.S. customers may have access to fast Prime delivery, while delivery times for other orders vary based on location and the shipping option selected at checkout. Estimated delivery times will be displayed during checkout.
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-[#E8DFD5] bg-white overflow-hidden shadow-xs">
          <button type="button" class="js-pdp-accordion-header w-full p-5 flex items-center justify-between font-bold text-xs sm:text-sm text-[#191614] text-left hover:bg-[#FAF7F2] transition cursor-pointer">
            <span>What type of wood is used?</span>
            <svg class="w-4 h-4 transform transition-transform duration-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="js-pdp-accordion-content hidden p-5 pt-0 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
            <p class="pt-3">
              Our trivets are made from 100% natural solid wood, carefully selected for durability, strength, and a beautiful natural finish.
            </p>
          </div>
        </div>

        <div class="rounded-2xl border border-[#E8DFD5] bg-white overflow-hidden shadow-xs">
          <button type="button" class="js-pdp-accordion-header w-full p-5 flex items-center justify-between font-bold text-xs sm:text-sm text-[#191614] text-left hover:bg-[#FAF7F2] transition cursor-pointer">
            <span>What is your return & refund policy?</span>
            <svg class="w-4 h-4 transform transition-transform duration-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="js-pdp-accordion-content hidden p-5 pt-0 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
            <p class="pt-3">
              We want you to be completely satisfied with your purchase. Eligible items may be returned within 30 days of delivery through Amazon’s fulfillment network.
            </p>
          </div>
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

