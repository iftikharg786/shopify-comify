{%- comment -%}
  Single Product: FAQ Accordion Section
  File: sections/menvel-faq.liquid
{%- endcomment -%}

<section id="MenvelFAQ" class="menvel-faq py-16 sm:py-24 bg-[#F8F2E9] border-b border-[#EADFCF]">
  <div class="menvel-container max-w-4xl">
    
    <div class="text-center mb-16">
      <span class="menvel-eyebrow">Frequently Asked Questions</span>
      <h2 class="menvel-heading-lg text-[#1F1B17]">
        Got Questions? We’ve Got Answers.
      </h2>
      <p class="menvel-lead mt-4 text-[#655E56]">
        Everything you need to know about the Menvel Goods Foldable Black Walnut Trivet Set.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="space-y-4">
      
      <!-- FAQ 1 -->
      <div class="menvel-faq-item is-open">
        <button type="button" class="menvel-faq-question">
          <span>How many trivets are included in the set?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            Each set includes <strong>4 foldable wooden trivets</strong>, <strong>1 central weighted tree storage/display stand</strong>, and <strong>1 premium gold-foil gift box</strong>.
          </p>
        </div>
      </div>

      <!-- FAQ 2 -->
      <div class="menvel-faq-item">
        <button type="button" class="menvel-faq-question">
          <span>How does the automatic gravity unfolding mechanism work?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            Simply remove one of the folded trivet branches from the tree stand and place it flat on your tabletop. The balanced precision joints naturally expand via gravity into an 8-inch wide heat shield in one smooth, second-long motion. No springs, latches, or awkward locks required.
          </p>
        </div>
      </div>

      <!-- FAQ 3 -->
      <div class="menvel-faq-item">
        <button type="button" class="menvel-faq-question">
          <span>What cookware and temperature ratings are supported?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            The Menvel Trivet is heat-rated for temperatures up to <strong>450°F (232°C)</strong>. It is designed to safely hold heavy enamelled Dutch ovens (like Le Creuset), sizzling cast iron skillets, boiling teapots, soup tureens, and hot baking casserole dishes without transferring damaging heat to your delicate counters or dining table.
          </p>
        </div>
      </div>

      <!-- FAQ 4 -->
      <div class="menvel-faq-item">
        <button type="button" class="menvel-faq-question">
          <span>Is this real solid wood or composite veneer?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            Every piece is <strong>100% Solid Natural American Black Walnut</strong>. We never use particle board, plastic core, or artificial laminates. Each trivet features distinct organic grain, rich chocolate-walnut coloring, and hand-sanded edges.
          </p>
        </div>
      </div>

      <!-- FAQ 5 -->
      <div class="menvel-faq-item">
        <button type="button" class="menvel-faq-question">
          <span>How do I clean and maintain the walnut wood?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            Cleaning is effortless: simply wipe the surface with a damp cloth and mild dish soap, then air dry. To maintain the rich, vibrant luster of the natural wood over decades, we recommend rubbing a few drops of food-grade mineral or walnut oil onto the wood every 4–6 months. Do not soak in water or place in an automatic dishwasher.
          </p>
        </div>
      </div>

      <!-- FAQ 6 -->
      <div class="menvel-faq-item">
        <button type="button" class="menvel-faq-question">
          <span>Is it ready for gifting?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            Yes! Every Menvel set arrives in a custom, heavy-duty presentation box with gold-foil typography and molded protective inserts. It is completely ready to be gifted for weddings, bridal showers, housewarmings, Christmas, Mother's Day, or birthdays.
          </p>
        </div>
      </div>

      <!-- FAQ 7 -->
      <div class="menvel-faq-item">
        <button type="button" class="menvel-faq-question">
          <span>What is your return & guarantee policy?</span>
          <svg class="menvel-faq-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div class="menvel-faq-answer">
          <p>
            We stand behind our craftsmanship with a <strong>30-Day Risk-Free Money-Back Guarantee</strong>. If you are not completely enchanted by the beauty and functionality of the Menvel Tree Set, contact our support team for a full refund or hassle-free replacement.
          </p>
        </div>
      </div>

    </div>

    <!-- Need More Help Card -->
    <div class="mt-12 p-6 rounded-2xl bg-white border border-[#EADFCF] text-center shadow-xs">
      <h4 class="font-serif text-lg font-bold text-[#1F1B17]">Still have questions?</h4>
      <p class="text-xs text-[#655E56] mt-1">Our dedicated customer care team is here 7 days a week.</p>
      <a href="mailto:support@menvelgoods.com" class="inline-block mt-3 text-xs font-bold text-[#8A5428] hover:underline">
        Contact Support → support@menvelgoods.com
      </a>
    </div>

  </div>
</section>

