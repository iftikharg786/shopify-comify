<section class="menvel-comparison py-16 sm:py-24 bg-white border-b border-[#EADFCF]">
  <div class="menvel-container">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="menvel-eyebrow">The Honest Comparison</span>
      <h2 class="menvel-heading-lg text-[#1F1B17]">
        How Menvel Compares to Ordinary Trivets.
      </h2>
      <p class="menvel-lead mt-4 text-[#655E56]">
        See why thousands of homeowners and interior designers are replacing bulky, unsightly pads with the Menvel Tree Set.
      </p>
    </div>

    <!-- Comparison Table Wrapper -->
    <div class="overflow-x-auto max-w-4xl mx-auto">
      <table class="menvel-comp-table">
        <thead>
          <tr class="bg-[#F8F2E9]">
            <th class="py-4 px-6 text-sm font-bold text-[#1F1B17]">Key Feature</th>
            <th class="py-4 px-6 text-sm font-bold text-white bg-[#55331F] rounded-t-lg">
              <div class="flex flex-col items-center">
                <span>🌲 MENVEL GOODS</span>
                <span class="text-[10px] text-[#D97706] font-semibold uppercase tracking-wider">Black Walnut Tree</span>
              </div>
            </th>
            <th class="py-4 px-6 text-sm font-semibold text-[#655E56]">Silicone Mats</th>
            <th class="py-4 px-6 text-sm font-semibold text-[#655E56]">Metal / Wire Trivets</th>
            <th class="py-4 px-6 text-sm font-semibold text-[#655E56]">Cork Pads</th>
          </tr>
        </thead>
        <tbody class="text-xs sm:text-sm">
          <tr>
            <td class="font-bold text-[#1F1B17]">Material Quality</td>
            <td class="menvel-comp-highlight text-[#15803D]">100% Solid American Walnut</td>
            <td class="text-[#655E56]">Synthetic Rubber / Plastic</td>
            <td class="text-[#655E56]">Coated Iron / Chrome</td>
            <td class="text-[#655E56]">Glued Pressed Cork</td>
          </tr>
          <tr>
            <td class="font-bold text-[#1F1B17]">Countertop Décor</td>
            <td class="menvel-comp-highlight text-[#15803D]">✓ Sculptural Centerpiece</td>
            <td class="text-red-500 font-bold">✕ Shoved in drawers</td>
            <td class="text-red-500 font-bold">✕ Clunky & utilitarian</td>
            <td class="text-red-500 font-bold">✕ Unattractive & plain</td>
          </tr>
          <tr>
            <td class="font-bold text-[#1F1B17]">Surface Protection</td>
            <td class="menvel-comp-highlight text-[#15803D]">✓ Zero-Scratch Polished Base</td>
            <td class="text-[#655E56]">Condensation traps underneath</td>
            <td class="text-red-500 font-bold">✕ Metal scratches table finish</td>
            <td class="text-[#655E56]">Stains & crumbles</td>
          </tr>
          <tr>
            <td class="font-bold text-[#1F1B17]">Folding Mechanism</td>
            <td class="menvel-comp-highlight text-[#15803D]">✓ 1-Second Gravity Unfold</td>
            <td class="text-[#655E56]">Floppy / Static</td>
            <td class="text-[#655E56]">Fixed rigid frame</td>
            <td class="text-[#655E56]">Static flat disk</td>
          </tr>
          <tr>
            <td class="font-bold text-[#1F1B17]">Heat Rating</td>
            <td class="menvel-comp-highlight text-[#15803D]">✓ Up to 450°F (Stovetop Safe)</td>
            <td class="text-[#655E56]">Melts at high heat</td>
            <td class="text-[#655E56]">Conducts heat to base</td>
            <td class="text-[#655E56]">Burns & chars easily</td>
          </tr>
          <tr>
            <td class="font-bold text-[#1F1B17]">Gift Packaging</td>
            <td class="menvel-comp-highlight text-[#15803D]">✓ Custom Luxury Gift Box</td>
            <td class="text-red-500 font-bold">✕ Clear plastic bag</td>
            <td class="text-red-500 font-bold">✕ Brown cardboard</td>
            <td class="text-red-500 font-bold">✕ Shrink wrap</td>
          </tr>
        </tbody>
      </table>
    </div>

  </div>
</section>

