{%- comment -%}
  Menvel Goods - About Us Master Hero & Story (Luxury Editorial Brand Layout)
  File: sections/menvel-about-story.liquid
{%- endcomment -%}

<section class="py-16 sm:py-24 bg-white border-b border-[#E8DFD5]" role="region" aria-label="About Menvel Goods" data-section-id="{{ section.id }}">
  <div class="menvel-container">
    
    <!-- Top Editorial Eyebrow & Hero Heading -->
    <div class="max-w-3xl mx-auto text-center space-y-4 mb-16">
      <span class="menvel-eyebrow text-[#8A4315]">{{ section.settings.eyebrow | default: "✦ OUR HERITAGE & PHILOSOPHY" }}</span>
      <h1 class="menvel-heading-serif text-3xl sm:text-5xl lg:text-6xl text-[#191614] leading-tight">
        {{ section.settings.heading | default: "Crafted By Nature.<br>Designed For Your Table." }}
      </h1>
      <p class="text-sm sm:text-base text-[#6B6259] leading-relaxed max-w-2xl mx-auto">
        {{ section.settings.subheading | default: "We believe kitchen essentials shouldn't be hidden away in crowded drawers. Menvel Goods was born to create functional wood decor that protects your surfaces while celebrating the timeless beauty of natural hardwood." }}
      </p>
      <div class="w-16 h-0.5 bg-[#3A2213] mx-auto mt-6 rounded-full"></div>
    </div>

    <!-- Editorial 2-Column Split -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      
      <!-- Left: Studio Showcase Photo -->
      <div class="lg:col-span-6">
        <div class="relative w-full aspect-square rounded-2xl overflow-hidden border border-[#E8DFD5] bg-[#FBF7F2] shadow-sm group flex items-center justify-center p-6">
          <img src="{% if section.settings.story_image != blank %}{{ section.settings.story_image | image_url: width: 1000 }}{% else %}{{ 'menvel-hero-showcase.jpg' | asset_url }}{% endif %}" 
               alt="{{ section.settings.heading | escape }}" 
               class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" 
               loading="eager">
          <div class="absolute bottom-4 left-4 bg-white/95 backdrop-blur-xs px-4 py-2.5 rounded-xl border border-[#E8DFD5] shadow-xs">
            <span class="text-xs font-serif font-bold text-[#191614] flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#15803D]"></span>
              {{ section.settings.image_badge | default: "Hand-Finished with Botanical Oils" }}
            </span>
          </div>
        </div>
      </div>

      <!-- Right: Narrative Copy -->
      <div class="lg:col-span-6 space-y-6 text-left">
        <div>
          <span class="menvel-eyebrow text-[#15803D]">{{ section.settings.story_eyebrow | default: "OUR BEGINNING" }}</span>
          <h2 class="menvel-heading-serif text-2xl sm:text-3xl text-[#191614] mt-1">
            {{ section.settings.story_heading | default: "Say Goodbye to Toxic Silicone & Ruined Counters" }}
          </h2>
        </div>

        <div class="prose text-sm text-[#6B6259] leading-relaxed space-y-4 font-sans">
          <p>
            {{ section.settings.story_paragraph_1 | default: "For years, kitchen trivets were treated as an afterthought — flimsy silicone mats that melted, warped cork pads that absorbed stains, or clumsy metal wire racks that scratched delicate dining tables." }}
          </p>

          <p>
            {{ section.settings.story_paragraph_2 | default: "We asked ourselves a simple question: <em>What if surface protection could be an architectural centerpiece you are proud to display?</em>" }}
          </p>

          <p>
            {{ section.settings.story_paragraph_3 | default: "Inspired by minimalist Scandinavian aesthetics and traditional woodworking joinery, we engineered the <strong>Menvel Foldable Tree Trivet</strong> — an automatic gravity-open design sculpted from 100% solid Black Walnut and Natural Beech wood. When you set cookware down, it expands into a balanced protective star; when lifted, it stands proudly as a decorative tree sculpture on your countertop." }}
          </p>
        </div>

        <!-- Quote Callout -->
        <div class="p-5 rounded-xl bg-[#FBF7F2] border-l-4 border-[#3A2213] text-sm text-[#191614] italic font-serif leading-relaxed">
          "{{ section.settings.quote | default: "Every piece of wood has its own unique grain story. We simply shape it so it protects your family's gathering place for generations." }}"
        </div>

        <!-- 3 Brand Highlights -->
        <div class="grid grid-cols-3 gap-4 pt-2 border-t border-[#E8DFD5]">
          <div>
            <span class="font-serif font-bold text-lg text-[#3A2213] block">100%</span>
            <span class="text-xs text-[#6B6259]">Solid Hardwood</span>
          </div>
          <div>
            <span class="font-serif font-bold text-lg text-[#3A2213] block">450°F</span>
            <span class="text-xs text-[#6B6259]">Heat Protection</span>
          </div>
          <div>
            <span class="font-serif font-bold text-lg text-[#3A2213] block">0%</span>
            <span class="text-xs text-[#6B6259]">Plastics or Toxins</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

