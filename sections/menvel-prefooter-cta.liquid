{%- comment -%}
  Single Product: Pre-Footer Banner CTA Section (Compact Spacing & Refined Look)
  File: sections/menvel-prefooter-cta.liquid
{%- endcomment -%}

<section class="py-8 sm:py-10 bg-[#F9F5F0]" role="region" aria-label="Order Trivet Set Pre-Footer">
  <div class="menvel-container">
    
    <div class="bg-[#3D2314] text-white rounded-2xl p-5 sm:p-7 lg:p-8 shadow-md flex flex-col lg:flex-row items-center justify-between gap-6">
      
      <!-- Left: Thumbnail + Heading & Subtitle -->
      <div class="flex items-center gap-4 sm:gap-6 flex-1">
        <div class="w-18 h-18 sm:w-22 sm:h-22 rounded-xl bg-white/10 p-2 flex-shrink-0 flex items-center justify-center border border-white/15 shadow-inner">
          <img src="{{ 'menvel-product-main.jpg' | asset_url }}" alt="Foldable Trivet Set" class="w-full h-full object-contain">
        </div>
        <div>
          <h2 class="font-serif text-xl sm:text-2xl lg:text-3xl font-bold text-white leading-tight">
            Protect Your Table Beautifully.
          </h2>
          <p class="text-xs sm:text-sm text-white/80 mt-1 leading-relaxed max-w-md">
            Add the Menvel Goods Solid Hardwood Trivet Set to your kitchen today.
          </p>
        </div>
      </div>

      <!-- Right: Price Block & Action Buttons -->
      <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row items-center sm:items-end lg:items-end xl:items-center gap-3 sm:gap-5 flex-shrink-0">
        
        <!-- Price Row -->
        <div class="flex items-center gap-2.5">
          <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">$18.99</span>
          <span class="text-sm sm:text-base font-medium text-white/50 line-through">$24.99</span>
          <span class="px-2.5 py-0.5 bg-[#DC2626] text-white text-[11px] font-bold rounded-md uppercase tracking-wide shadow-xs">
            Save 24%
          </span>
        </div>

        <!-- Buttons Row -->
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <!-- Buy It Now Button -->
          <a href="/products/foldable-black-walnut-wooden-trivet-set" 
             class="flex-1 sm:flex-initial min-w-[130px] h-11 px-6 rounded-lg bg-white text-[#3D2314] font-extrabold text-xs uppercase tracking-wider flex items-center justify-center hover:bg-[#F3ECE2] transition-all transform hover:-translate-y-0.5 shadow-sm whitespace-nowrap">
            <span>BUY IT NOW</span>
          </a>

          <!-- View Product Button -->
          <a href="/products/foldable-black-walnut-wooden-trivet-set" 
             class="flex-1 sm:flex-initial min-w-[130px] h-11 px-6 rounded-lg bg-white/10 hover:bg-white/20 text-white font-extrabold text-xs uppercase tracking-wider border border-white/30 hover:border-white/60 flex items-center justify-center transition-all transform hover:-translate-y-0.5 whitespace-nowrap">
            <span>VIEW DETAILS</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Menvel Pre-Footer CTA",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Menvel Pre-Footer CTA"
    }
  ]
}
{% endschema %}
