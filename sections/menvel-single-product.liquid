{%- comment -%}
  Menvel Goods - Dynamic 2-Variant Single Product PDP (Shopify Live Compatible)
  File: sections/menvel-single-product.liquid
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_image = current_variant.featured_image | default: product.featured_image
  assign money_price = current_variant.price | default: product.price | money
  assign compare_price = current_variant.compare_at_price | default: product.compare_at_price | money
-%}

<div class="menvel-pdp-wrapper py-6 sm:py-10 bg-white" data-section-id="{{ section.id }}" data-section-type="product" role="main">
  <div class="menvel-container">
    
    <!-- 2-Column Split: Visual Storytelling (Left) + Sticky Purchase Details (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- =========================================================================
           LEFT COLUMN: Sticky Vertical Gallery (Left) + Main Photo + Feature Highlights
           ========================================================================= -->
      <div class="lg:col-span-7 space-y-6 lg:sticky lg:top-24 self-start">
        
        <!-- Gallery Wrapper: Vertical Thumbnails on Left + Main Photo on Right -->
        <div class="flex flex-col-reverse md:flex-row gap-4 items-start">
          
          <!-- 1. Vertical Thumbnail Strip (Left side on desktop, horizontal on mobile) -->
          <div class="flex md:flex-col gap-2 overflow-x-auto md:overflow-y-auto max-h-[520px] pb-2 md:pb-0 w-full md:w-[76px] flex-shrink-0 pr-1" style="scrollbar-width: thin;">
            {%- if product.images.size > 0 -%}
              {%- for image in product.images -%}
                <button type="button" 
                        class="js-pdp-thumb {% if forloop.first %}is-active border-2 border-[#191614]{% else %}border border-[#E8DFD5]{% endif %} w-16 h-16 md:w-[70px] md:h-[70px] rounded-xl p-1 bg-white overflow-hidden transition flex-shrink-0 cursor-pointer shadow-xs hover:border-[#191614]"
                        data-large-src="{{ image | image_url: width: 1200 }}"
                        aria-label="Product Image {{ forloop.index }}">
                  <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}" class="w-full h-full object-contain rounded-lg">
                </button>
              {%- endfor -%}
            {%- else -%}
              <button type="button" 
                      class="js-pdp-thumb is-active w-16 h-16 md:w-20 md:h-20 rounded-xl border-2 border-[#191614] p-1 bg-white overflow-hidden transition flex-shrink-0 cursor-pointer shadow-xs"
                      data-large-src="{{ 'menvel-pdp-main-hero.jpg' | asset_url }}"
                      data-variant-name="Black Walnut"
                      aria-label="Thumbnail 1">
                <img src="{{ 'menvel-pdp-main-hero.jpg' | asset_url }}" alt="Dark Walnut Set" class="w-full h-full object-contain rounded-lg">
              </button>

              <button type="button" 
                      class="js-pdp-thumb w-16 h-16 md:w-20 md:h-20 rounded-xl border border-[#E8DFD5] p-1 bg-white overflow-hidden transition flex-shrink-0 hover:border-[#191614] cursor-pointer shadow-xs"
                      data-large-src="{{ 'menvel-beech-showcase.jpg' | asset_url }}"
                      data-variant-name="Natural Beech"
                      aria-label="Thumbnail 2">
                <img src="{{ 'menvel-beech-showcase.jpg' | asset_url }}" alt="Natural Beech Set" class="w-full h-full object-contain rounded-lg">
              </button>
            {%- endif -%}
          </div>

          <!-- 2. Master Product Photo Frame -->
          <div class="relative w-full aspect-square rounded-2xl overflow-hidden border border-[#E8DFD5] bg-[#FBF7F2] p-4 flex items-center justify-center shadow-xs group flex-1">
            <!-- Best Seller Badge -->
            <span class="absolute top-4 left-4 z-10 bg-[#8A4315] text-white text-[10px] sm:text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full shadow-md">
              BEST SELLER
            </span>

            <!-- Main Image (100% visible, not cropped) -->
            <img id="PDPMainImage" 
                 src="{% if featured_image %}{{ featured_image | image_url: width: 1200 }}{% else %}{{ 'menvel-pdp-main-hero.jpg' | asset_url }}{% endif %}" 
                 alt="{{ product.title | default: 'Foldable Wooden Trivet Set' | escape }}" 
                 class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
                 loading="eager">
          </div>

        </div>

        <!-- 3. Key Feature Highlights (Environmentally Safe) -->
        <div class="rounded-2xl border border-[#E8DFD5] bg-[#FAF7F2] p-5 space-y-3">
          <h4 class="font-serif font-bold text-sm text-[#191614]">Product Features</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-[#6B6259]">
            <div class="flex items-start gap-2">
              <span class="text-[#15803D] font-bold">✓</span>
              <span><strong>Environmentally Safe:</strong> 100% solid natural wood</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-[#15803D] font-bold">✓</span>
              <span><strong>Heat Protection:</strong> Tested up to 450°F</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-[#15803D] font-bold">✓</span>
              <span><strong>Auto Gravity Drop:</strong> Expands smoothly upon contact</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-[#15803D] font-bold">✓</span>
              <span><strong>Compact Tree Stand:</strong> Decorative 6-petal design</span>
            </div>
          </div>
        </div>

      </div>

      <!-- =========================================================================
           RIGHT COLUMN: Details & Accordions (Scrolls while left side stays sticky)
           ========================================================================= -->
      <div class="lg:col-span-5 space-y-5 text-left bg-white">
        
        <!-- Rating Header (Unified) -->
        <div class="flex items-center gap-1.5 text-xs text-[#D97706]">
          <span>★★★★★</span>
          <span class="font-bold text-[#191614]">4.9</span>
          <span class="text-neutral-500 font-medium">(48 reviews)</span>
        </div>

        <!-- Product Title -->
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-[#191614] leading-snug">
          {{ product.title | default: "Foldable Wooden Trivet Set For Hot Dishes – 4 Trivets + 1 Stand" }}
        </h1>

        <!-- Price Display -->
        <div class="flex items-baseline gap-3">
          {%- if product.compare_at_price > product.price -%}
            <span class="text-xs text-neutral-400 line-through font-medium">{{ compare_price }}</span>
          {%- else -%}
            <span class="text-xs text-neutral-400 line-through font-medium">$19.99 USD</span>
          {%- endif -%}

          <span class="text-2xl font-bold text-[#191614]" id="PDPMainPrice">
            {%- if product.price -%}{{ money_price }}{%- else -%}$18.99 USD{%- endif -%}
          </span>

          <span class="text-[11px] font-bold text-[#15803D] bg-[#DCFCE7] px-2.5 py-0.5 rounded-full">
            Save 5%
          </span>
        </div>

        <!-- Short Description -->
        <p class="text-xs text-[#6B6259] leading-relaxed">
          {{ product.description | strip_html | truncatewords: 35 | default: "Protect Your Surfaces. Serve Beautifully. An environmentally safe foldable wooden trivet set designed to protect tables and countertops from hot pots, pans, bowls, Dutch ovens, serving dishes, teapots, and kettles." }}
        </p>

        <!-- Scarcity Urgency Progress Bar -->
        <div class="space-y-1.5 pt-1">
          <div class="flex items-center gap-1.5 text-xs font-bold text-[#D93829]">
            <span>🔥</span>
            <span>HURRY! ONLY 43 LEFT IN STOCK</span>
          </div>
          <div class="w-full bg-[#F3F4F6] rounded-full h-2 overflow-hidden border border-[#E5E7EB]">
            <div class="bg-gradient-to-r from-[#F97316] to-[#DC2626] h-full rounded-full w-[68%] transition-all duration-500"></div>
          </div>
        </div>

        <!-- Dynamic Shopify Product Form -->
        {% form 'product', product, id: 'PDPProductForm', class: 'space-y-4' %}
          
          <!-- Hidden Variant ID Input for Shopify Cart -->
          <input type="hidden" name="id" id="PDPVariantIdInput" value="{{ current_variant.id | default: 1 }}">

          <!-- Color Variations -->
          <div class="pt-2 space-y-2.5">
            <div class="text-xs font-semibold text-[#191614]">
              Color: <strong id="PDPActiveColorName" class="text-[#3A2213]">{{ current_variant.title | default: "Black Walnut" }}</strong>
            </div>

            <div class="flex items-center gap-3">
              
              <!-- Variation 1: Black Walnut -->
              <button type="button" 
                       class="js-pdp-color-swatch is-active relative w-18 h-22 rounded-xl border-2 border-[#1A56DB] bg-white p-1.5 shadow-xs transition cursor-pointer flex flex-col items-center justify-center overflow-hidden"
                      data-color-name="Black Walnut"
                      data-variant-id="{% if product.variants.size > 0 %}{{ product.variants[0].id }}{% else %}1{% endif %}"
                      data-img-src="{{ 'menvel-pdp-main-hero.jpg' | asset_url }}"
                      data-sku="MG-RD-001-BW"
                      data-price="$18.99 USD"
                      aria-label="Select Black Walnut">
                <div class="w-full h-12 flex items-center justify-center">
                  <img src="{{ 'menvel-swatch-walnut.jpg' | asset_url }}" alt="Black Walnut" class="w-full h-full object-contain">
                </div>
                <span class="text-[10px] font-bold text-[#191614] mt-1">Black Walnut</span>
              </button>

              <!-- Variation 2: Natural Beech -->
              <button type="button" 
                      class="js-pdp-color-swatch relative w-18 h-22 rounded-xl border border-[#D1D5DB] bg-white p-1.5 shadow-xs transition hover:border-[#1A56DB] cursor-pointer flex flex-col items-center justify-center overflow-hidden"
                      data-color-name="Natural Beech"
                      data-variant-id="{% if product.variants.size > 1 %}{{ product.variants[1].id }}{% else %}2{% endif %}"
                      data-img-src="{{ 'menvel-beech-showcase.jpg' | asset_url }}"
                      data-sku="MG-RD-002-NB"
                      data-price="$18.99 USD"
                      aria-label="Select Natural Beech">
                <div class="w-full h-12 flex items-center justify-center">
                  <img src="{{ 'menvel-swatch-beech.jpg' | asset_url }}" alt="Natural Beech" class="w-full h-full object-contain">
                </div>
                <span class="text-[10px] font-bold text-[#191614] mt-1">Natural Beech</span>
              </button>

            </div>
          </div>

          <!-- Quantity Stepper -->
          <div class="flex items-center border border-[#D1D5DB] rounded-md h-11 bg-white px-3 w-32 justify-between">
            <button type="button" id="PDPQtyMinus" class="text-sm font-bold text-neutral-600 hover:text-black transition" aria-label="Decrease quantity">-</button>
            <input type="number" id="PDPQtyInput" name="quantity" value="1" min="1" max="99" class="w-10 text-center font-bold text-xs text-[#191614] border-none outline-none">
            <button type="button" id="PDPQtyPlus" class="text-sm font-bold text-neutral-600 hover:text-black transition" aria-label="Increase quantity">+</button>
          </div>

          <!-- Add to Cart & Buy It Now Buttons -->
          <div class="space-y-2 pt-1">
            <button type="button" 
                    id="PDPAddToCartBtn"
                    onclick="window.openMenvelDrawer()" 
                    class="w-full h-12 bg-black text-white rounded-md text-xs font-bold uppercase tracking-wider hover:bg-neutral-800 transition flex items-center justify-center gap-2 shadow-xs cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
              </svg>
              <span>ADD TO CART</span>
            </button>

            <button type="button" 
                    id="PDPBuyNowBtn"
                    class="w-full h-12 bg-black text-white rounded-md text-xs font-bold uppercase tracking-wider hover:bg-neutral-800 transition flex items-center justify-center gap-2 shadow-xs cursor-pointer">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
              <span>BUY IT NOW</span>
            </button>
          </div>

        {% endform %}

        <!-- Mini Trust Badges Grid -->
        <div class="grid grid-cols-2 gap-3 pt-3 border-t border-[#E8DFD5] text-[11px] text-[#191614] font-medium">
          <div class="flex items-center gap-2">
            <span>🛡️</span>
            <span>30-Day Money Back</span>
          </div>
          <div class="flex items-center gap-2">
            <span>📦</span>
            <span>Tracked Delivery</span>
          </div>
          <div class="flex items-center gap-2">
            <span>🪵</span>
            <span>Solid Natural Wood</span>
          </div>
          <div class="flex items-center gap-2">
            <span>🌡️</span>
            <span>Heat Proof to 450°F</span>
          </div>
        </div>

        <!-- Interactive Collapsible Accordions (100% Mockup Match) -->
        <div class="pt-4 border-t border-[#E8DFD5] space-y-3">
          
          <!-- Accordion 1: DESCRIPTION (Open by default) -->
          <div class="rounded-xl border border-[#E8DFD5] bg-white overflow-hidden">
            <button type="button" class="js-pdp-accordion-header w-full p-4 flex items-center justify-between font-bold text-xs uppercase tracking-wider text-[#191614] text-left hover:bg-[#FBF7F2] transition">
              <span>DESCRIPTION</span>
              <svg class="w-4 h-4 transform transition-transform duration-300 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="js-pdp-accordion-content p-4 pt-0 space-y-4 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
              <p class="font-bold text-[#191614] pt-3">Protect Your Surfaces. Serve Beautifully.</p>
              <p>An environmentally safe foldable wooden trivet set designed to protect tables and countertops from hot pots, pans, bowls, Dutch ovens, serving dishes, teapots, and kettles.</p>

              <div class="space-y-1">
                <h4 class="font-bold text-[#191614]">What's Included</h4>
                <ul class="list-disc pl-4 space-y-0.5">
                  <li>4 foldable wooden trivets (6-petal automatic gravity opening)</li>
                  <li>1 wooden stand / storage holder</li>
                </ul>
              </div>

              <div class="space-y-1">
                <h4 class="font-bold text-[#191614]">Why You'll Love It</h4>
                <ul class="space-y-1">
                  <li><strong>Protects Your Surfaces:</strong> Creates an effective heat barrier between hot cookware and tables or countertops.</li>
                  <li><strong>Foldable & Space-Saving:</strong> Folds neatly into a compact tree shape when not in use.</li>
                  <li><strong>Easy to Use:</strong> Expand the trivet and place it underneath hot cookware or serving dishes.</li>
                  <li><strong>Easy to Clean:</strong> Wipe clean with a soft, slightly damp cloth.</li>
                </ul>
              </div>
          <div class="rounded-xl border border-[#E8DFD5] bg-white overflow-hidden">
            <button type="button" class="js-pdp-accordion-header w-full p-4 flex items-center justify-between font-bold text-xs uppercase tracking-wider text-[#191614] text-left hover:bg-[#FBF7F2] transition">
              <span>ADDITIONAL INFORMATION</span>
              <svg class="w-4 h-4 transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="js-pdp-accordion-content hidden p-4 pt-3 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
              <table class="w-full text-xs">
                <tbody>
                  <tr class="border-b border-[#E8DFD5]"><td class="py-2 font-bold text-[#191614]">Material</td><td class="py-2 text-right">100% Solid Natural Hardwood</td></tr>
                  <tr class="border-b border-[#E8DFD5]"><td class="py-2 font-bold text-[#191614]">Dimensions</td><td class="py-2 text-right">8.5" H Stand • 7.8" Trivet</td></tr>
                  <tr class="border-b border-[#E8DFD5]"><td class="py-2 font-bold text-[#191614]">Heat Rating</td><td class="py-2 text-right">Up to 450°F (232°C)</td></tr>
                  <tr><td class="py-2 font-bold text-[#191614]">Care</td><td class="py-2 text-right">Wipe clean with damp cloth</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Accordion 3: REVIEWS (48) -->
          <div class="rounded-xl border border-[#E8DFD5] bg-white overflow-hidden">
            <button type="button" class="js-pdp-accordion-header w-full p-4 flex items-center justify-between font-bold text-xs uppercase tracking-wider text-[#191614] text-left hover:bg-[#FBF7F2] transition">
              <span>REVIEWS (48)</span>
              <svg class="w-4 h-4 transform transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div class="js-pdp-accordion-content hidden p-4 pt-3 space-y-3 text-xs text-[#6B6259] leading-relaxed border-t border-[#E8DFD5]/40">
              <div class="p-3 rounded-lg bg-[#FBF7F2]">
                <div class="flex text-[#D97706] text-xs mb-1">★★★★★</div>
                <h5 class="font-bold text-xs text-[#191614]">Sarah M. — Verified Buyer</h5>
                <p class="text-[11px] text-[#6B6259] mt-0.5">"The wood grain is stunning and the automatic gravity drop works like magic. It stays on my table 24/7!"</p>
              </div>
              <div class="p-3 rounded-lg bg-[#FBF7F2]">
                <div class="flex text-[#D97706] text-xs mb-1">★★★★★</div>
                <h5 class="font-bold text-xs text-[#191614]">David R. — Verified Buyer</h5>
                <p class="text-[11px] text-[#6B6259] mt-0.5">"Bought 4 sets as holiday gifts. Unbelievable craftsmanship and packaging."</p>
              </div>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Single Product (PDP)",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Stock Text",
      "default": "HURRY! ONLY 43 LEFT IN STOCK"
    },
    {
      "type": "text",
      "id": "special_offer_heading",
      "label": "Special Offer Heading",
      "default": "SPECIAL OFFER"
    },
    {
      "type": "text",
      "id": "promo_code_text",
      "label": "Promo Code Callout",
      "default": "Sale 30% Off Use Code: Deal30"
    },
    {
      "type": "text",
      "id": "visitors_text",
      "label": "Real-time Visitors Text",
      "default": "Real-time 11 Visitors right now"
    }
  ],
  "blocks": [
    {
      "type": "custom_tab",
      "name": "Accordion Tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab Title",
          "default": "SHIPPING & RETURNS"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab Content",
          "default": "<p>We offer free standard U.S. shipping on orders over $50. All orders include a 30-day money-back guarantee.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Single Product (PDP)"
    }
  ]
}
{% endschema %}
