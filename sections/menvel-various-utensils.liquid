{%- comment -%}
  Menvel Goods - Meal & Moment 4-Card Grid (100% Mockup Match with 1024px Uploads)
  File: sections/menvel-various-utensils.liquid
{%- endcomment -%}

<section id="MenvelMoments" class="py-16 sm:py-24 bg-[#FBF7F2] border-b border-[#E8DFD5]" role="region" aria-label="Meal and Moment Grid">
  <div class="menvel-container text-center">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto mb-12">
      <h2 class="menvel-heading-serif text-3xl sm:text-4xl text-[#191614]">
        Perfect For Every Meal & Moment
      </h2>
      <p class="text-xs sm:text-sm text-[#6B6259] mt-2">
        Versatile protection for everything from morning tea to Sunday roasts.
      </p>
      <div class="w-12 h-0.5 bg-[#3A2213] mx-auto mt-4 rounded-full"></div>
    </div>

    <!-- 4 Cards Grid with Newly Uploaded High-Res Photos -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
      
      <!-- Card 1: Cast Iron Skillets -->
      <div class="menvel-moment-card">
        <div class="aspect-square w-full overflow-hidden bg-white">
          <img src="{{ 'menvel-moment-skillet.jpg' | asset_url }}" 
               alt="Cast Iron Skillet with Fried Egg & Sausage on Menvel Trivet" 
               class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
               loading="lazy">
        </div>
        <div class="p-4 bg-white flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-serif font-bold text-sm text-[#191614]">Cast Iron Skillets</h3>
            <p class="text-[11px] text-[#6B6259] mt-1 leading-relaxed">
              Heavy-duty protection for sizzling hot cast iron skillets right off the stove.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2: Dutch Ovens & Pots -->
      <div class="menvel-moment-card">
        <div class="aspect-square w-full overflow-hidden bg-white">
          <img src="{{ 'menvel-moment-plate.jpg' | asset_url }}" 
               alt="Dinner Plate with Roasted Veggies & Steak on Menvel Trivet" 
               class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
               loading="lazy">
        </div>
        <div class="p-4 bg-white flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-serif font-bold text-sm text-[#191614]">Quick Meals & Pots</h3>
            <p class="text-[11px] text-[#6B6259] mt-1 leading-relaxed">
              Supports heavy hot plates, boiling pots, and pans effortlessly with balanced protection.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3: Soups & Serving Dishes -->
      <div class="menvel-moment-card">
        <div class="aspect-square w-full overflow-hidden bg-white">
          <img src="{{ 'menvel-moment-casserole.jpg' | asset_url }}" 
               alt="Red Casserole Dutch Oven on Menvel Trivet" 
               class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
               loading="lazy">
        </div>
        <div class="p-4 bg-white flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-serif font-bold text-sm text-[#191614]">Soups & Serving Dishes</h3>
            <p class="text-[11px] text-[#6B6259] mt-1 leading-relaxed">
              Keep your dining table safe during family dinners, buffets, and holiday feasts.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 4: Teapots & Kettles -->
      <div class="menvel-moment-card">
        <div class="aspect-square w-full overflow-hidden bg-white">
          <img src="{{ 'menvel-moment-teapot.jpg' | asset_url }}" 
               alt="Glass Teapot with Red Lid on Menvel Trivet" 
               class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" 
               loading="lazy">
        </div>
        <div class="p-4 bg-white flex-1 flex flex-col justify-between">
          <div>
            <h3 class="font-serif font-bold text-sm text-[#191614]">Teapots & Kettles</h3>
            <p class="text-[11px] text-[#6B6259] mt-1 leading-relaxed">
              Ideal for boiling kettles, glass teapots, and French presses without scorching surfaces.
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Menvel Meal and Moments",
  "tag": "section",
  "settings": []
}
{% endschema %}
