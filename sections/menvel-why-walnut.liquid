<section class="menvel-why-walnut py-16 sm:py-24 bg-[#F8F2E9] border-b border-[#EADFCF]">
  <div class="menvel-container">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left: Visual Craftsmanship Showcase -->
      <div class="lg:col-span-6 relative">
        <div class="relative rounded-3xl overflow-hidden border border-[#EADFCF] shadow-2xl bg-white aspect-[4/3]">
          <img src="https://images.unsplash.com/photo-1616046229478-9901c5536a45?auto=format&fit=crop&w=1000&q=85" 
               alt="Black Walnut Hardwood Grain Detail" 
               class="w-full h-full object-cover"
               loading="lazy">
          
          <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl bg-white/95 backdrop-blur-md border border-[#EADFCF] shadow-lg flex items-center justify-between">
            <div>
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#8A5428]">Source Certified</span>
              <p class="font-serif text-sm font-bold text-[#1F1B17]">100% Sustainable American Walnut</p>
            </div>
            <span class="text-2xl">🌱</span>
          </div>
        </div>
      </div>

      <!-- Right: Value Proposition Details -->
      <div class="lg:col-span-6 space-y-6">
        <span class="menvel-eyebrow">Artisan Material Selection</span>
        <h2 class="menvel-heading-lg text-[#1F1B17]">
          Why Choose Black Walnut?
        </h2>
        <p class="menvel-lead text-[#655E56]">
          Unlike cheap pine or synthetic bamboo, American Black Walnut is celebrated for its dense grain structure, rich chocolate undertones, and natural resistance to high heat.
        </p>

        <div class="space-y-4 pt-2">
          
          <!-- Feature 1 -->
          <div class="p-4 rounded-xl bg-white border border-[#EADFCF] shadow-xs flex items-start gap-4">
            <span class="p-2.5 rounded-lg bg-[#F8F2E9] text-[#8A5428] text-xl flex-shrink-0">🪵</span>
            <div>
              <h3 class="font-serif text-lg font-bold text-[#1F1B17]">Premium Craftsmanship</h3>
              <p class="text-xs text-[#655E56] mt-1 leading-relaxed">
                Hand-finished with food-safe botanical oils that accentuate the natural wood grain while sealing the surface against moisture and kitchen spills.
              </p>
            </div>
          </div>

          <!-- Feature 2 -->
          <div class="p-4 rounded-xl bg-white border border-[#EADFCF] shadow-xs flex items-start gap-4">
            <span class="p-2.5 rounded-lg bg-[#F8F2E9] text-[#8A5428] text-xl flex-shrink-0">🎨</span>
            <div>
              <h3 class="font-serif text-lg font-bold text-[#1F1B17]">Natural Organic Beauty</h3>
              <p class="text-xs text-[#655E56] mt-1 leading-relaxed">
                No two pieces are identical. Every trivet exhibits individual whorls, warm tones, and character that ages gracefully with use.
              </p>
            </div>
          </div>

          <!-- Feature 3 -->
          <div class="p-4 rounded-xl bg-white border border-[#EADFCF] shadow-xs flex items-start gap-4">
            <span class="p-2.5 rounded-lg bg-[#F8F2E9] text-[#8A5428] text-xl flex-shrink-0">🔥</span>
            <div>
              <h3 class="font-serif text-lg font-bold text-[#1F1B17]">Natural Thermal Barrier</h3>
              <p class="text-xs text-[#655E56] mt-1 leading-relaxed">
                High density hardwood dissipates heat slowly and evenly, preventing thermal shock to glass, granite, quartz, and dining table veneers.
              </p>
            </div>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>

