{%- comment -%}
  Single Product: One Simple Motion Section with High-Res Weight Diagram
  File: sections/menvel-one-simple-motion.liquid
{%- endcomment -%}

<section id="MenvelHowItWorks" class="py-14 sm:py-20 bg-white border-b border-[#E8DDCE]" role="region" aria-label="How Menvel Trivet Works">
  <div class="menvel-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left: Step descriptions -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <h2 class="menvel-title-main uppercase tracking-wide">
            ONE SIMPLE MOTION.
          </h2>
          <p class="menvel-subtitle mt-1">
            Effortless to use. Automatic gravity unfolding. Beautiful to store.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div class="menvel-step-item">
            <span class="menvel-step-badge">01</span>
            <div>
              <h3 class="font-bold text-xs text-[#1F1B17]">Lift</h3>
              <p class="text-[11px] text-[#6B635B] leading-tight">Take one trivet from the tree</p>
            </div>
          </div>

          <div class="menvel-step-item">
            <span class="menvel-step-badge">02</span>
            <div>
              <h3 class="font-bold text-xs text-[#1F1B17]">Place</h3>
              <p class="text-[11px] text-[#6B635B] leading-tight">Set it on the surface</p>
            </div>
          </div>

          <div class="menvel-step-item">
            <span class="menvel-step-badge">03</span>
            <div>
              <h3 class="font-bold text-xs text-[#1F1B17]">Unfold</h3>
              <p class="text-[11px] text-[#6B635B] leading-tight">Weight opens trivet flat instantly</p>
            </div>
          </div>

          <div class="menvel-step-item">
            <span class="menvel-step-badge">04</span>
            <div>
              <h3 class="font-bold text-xs text-[#1F1B17]">Protect</h3>
              <p class="text-[11px] text-[#6B635B] leading-tight">Springs back up when lifted</p>
            </div>
          </div>
        </div>

        <p class="text-xs font-semibold text-[#6B635B] italic pt-1">
          When you're finished, simply lift your cookware and return the trivet to the tree.
        </p>
      </div>

      <!-- Right: High-Res Diagram Visual -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl overflow-hidden border border-[#E8DDCE] shadow-md bg-[#F9F5F0]">
          <img src="{{ 'menvel-how-it-works-diagram.jpg' | asset_url }}" 
               alt="Designed to Work with Weight - 4-step Trivet Motion Diagram" 
               class="w-full h-auto object-cover"
               loading="lazy">
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menvel One Simple Motion",
  "tag": "section",
  "settings": [],
  "presets": [
    {
      "name": "Menvel One Simple Motion"
    }
  ]
}
{% endschema %}
