<!DOCTYPE html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <!-- Google Fonts & Tailwind CSS CDN for Live Shopify Theme Rendering -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

  <!-- Menvel Goods Master CSS -->
  {{ 'menvel-luxury.css' | asset_url | stylesheet_tag }}

  <!-- Shopify Header Hook -->
  {{ content_for_header }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    window.Shopify = window.Shopify || {};
    window.Shopify.money_format = {{ shop.money_format | json }};
    window.Shopify.currency = {{ shop.currency | json }};
  </script>
</head>

<body class="menvel-scope min-h-screen flex flex-col antialiased bg-white text-[#191614] selection:bg-[#3A2213] selection:text-white">
  
  <!-- Skip to Content for Accessibility -->
  <a class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-[#3A2213] text-white p-2 rounded z-50" href="#MainContent">
    Skip to content
  </a>

  <!-- 1. Global Announcement Bar -->
  {% section 'menvel-announcement' %}

  <!-- 2. Global Header -->
  {% section 'menvel-header' %}

  <!-- 3. Dynamic Page Content -->
  <main id="MainContent" class="flex-1 focus:outline-none" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  <!-- 4. Global Footer -->
  {% section 'menvel-footer' %}

  <!-- 5. Global Cart Drawer Component -->
  {% render 'menvel-cart-drawer' %}

  <!-- 6. Theme Master JavaScript -->
  <script src="{{ 'menvel-luxury.js' | asset_url }}" defer="defer"></script>

</body>
</html>
