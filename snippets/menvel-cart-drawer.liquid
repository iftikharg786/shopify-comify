{%- comment -%}
  Menvel Goods - Luxury AJAX Slide-Out Cart Drawer (Fixed + Beautiful)
  File: snippets/menvel-cart-drawer.liquid
{%- endcomment -%}

<div id="MenvelCartOverlay" class="menvel-drawer-overlay" aria-hidden="true"></div>

<aside id="MenvelCartDrawer" class="menvel-drawer" aria-modal="true" role="dialog" aria-label="Shopping Bag">
  
  <!-- Header -->
  <div class="p-5 border-b border-[#EADFCF] flex items-center justify-between bg-[#F8F2E9]">
    <div class="flex items-center gap-2.5">
      <svg class="w-5 h-5 text-[#3A2213]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
      </svg>
      <h3 class="font-serif text-lg font-bold text-[#1F1B17]">Your Shopping Bag</h3>
      <span class="js-cart-count bg-[#3A2213] text-white text-[11px] font-bold w-5 h-5 rounded-full flex items-center justify-center">
        {{ cart.item_count | default: 0 }}
      </span>
    </div>
    <button id="MenvelCloseDrawer" type="button" class="p-1.5 rounded-full text-[#655E56] hover:text-[#1F1B17] hover:bg-white transition" aria-label="Close Bag">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Free Shipping Progress Tracker -->
  <div class="px-5 py-3.5 bg-white border-b border-[#EADFCF]">
    {%- assign threshold_cents = 5000 -%}
    {%- assign cart_total = cart.total_price | default: 0 -%}
    {%- assign remaining_cents = threshold_cents | minus: cart_total -%}
    {%- assign progress_percent = cart_total | times: 100.0 | divided_by: threshold_cents -%}
    {%- if progress_percent > 100 -%}{%- assign progress_percent = 100 -%}{%- endif -%}

    <p id="MenvelShippingMsg" class="text-xs text-center font-semibold text-[#1F1B17] mb-2">
      {%- if remaining_cents <= 0 -%}
        🎉 You unlocked <strong>FREE U.S. Shipping</strong>!
      {%- else -%}
        Add <strong>{{ remaining_cents | money }}</strong> more to unlock <strong>FREE Shipping</strong>
      {%- endif -%}
    </p>
    <div class="w-full bg-[#F1E8DC] rounded-full h-1.5 overflow-hidden">
      <div id="MenvelShippingBarFill" class="bg-[#15803D] h-full rounded-full transition-all duration-500" style="width: {{ progress_percent }}%;"></div>
    </div>
  </div>

  <!-- Line Items Area -->
  <div id="MenvelDrawerBody" class="flex-1 overflow-y-auto p-5 space-y-4">
    {%- if cart.item_count > 0 -%}
      {%- for item in cart.items -%}
        <div class="flex gap-3.5 pb-4 border-b border-[#F0E8DC]">
          <!-- Product Image (FIXED: use item.image.src not asset_url) -->
          <a href="{{ item.url }}" class="w-20 h-20 rounded-xl bg-[#FBF7F2] overflow-hidden border border-[#E8DFD5] flex-shrink-0 flex items-center justify-center p-1.5">
            {%- if item.image != blank -%}
              <img src="{{ item.image | image_url: width: 200 }}"
                   alt="{{ item.title | escape }}"
                   class="w-full h-full object-contain"
                   loading="lazy">
            {%- else -%}
              <img src="{{ 'menvel-product-main.jpg' | asset_url }}"
                   alt="{{ item.title | escape }}"
                   class="w-full h-full object-contain">
            {%- endif -%}
          </a>

          <div class="flex-1 flex flex-col justify-between min-w-0">
            <div>
              <div class="flex justify-between items-start gap-2">
                <a href="{{ item.url }}" class="font-serif font-bold text-sm text-[#1F1B17] leading-snug hover:text-[#3A2213] transition line-clamp-2">
                  {{ item.product.title }}
                </a>
                <a href="{{ routes.cart_url }}/change?line={{ forloop.index }}&quantity=0"
                   class="text-xs text-neutral-400 hover:text-[#D93829] transition flex-shrink-0 mt-0.5"
                   aria-label="Remove {{ item.title | escape }}">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                  </svg>
                </a>
              </div>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="text-[11px] text-[#8A5428] font-semibold mt-0.5">{{ item.variant.title }}</p>
              {%- endunless -%}
            </div>
            <div class="flex justify-between items-center mt-2">
              <!-- Qty Stepper -->
              <div class="flex items-center gap-1.5 border border-[#E8DFD5] rounded-lg overflow-hidden bg-white">
                <button type="button"
                        class="js-qty-decrease px-2.5 py-1 text-[#3A2213] font-bold text-sm hover:bg-[#FBF7F2] transition"
                        data-line="{{ forloop.index }}"
                        data-qty="{{ item.quantity | minus: 1 }}"
                        aria-label="Decrease quantity">−</button>
                <span class="text-xs font-bold text-[#191614] min-w-[16px] text-center">{{ item.quantity }}</span>
                <button type="button"
                        class="js-qty-increase px-2.5 py-1 text-[#3A2213] font-bold text-sm hover:bg-[#FBF7F2] transition"
                        data-line="{{ forloop.index }}"
                        data-qty="{{ item.quantity | plus: 1 }}"
                        aria-label="Increase quantity">+</button>
              </div>
              <span class="font-bold text-sm text-[#1F1B17]">{{ item.final_line_price | money }}</span>
            </div>
          </div>
        </div>
      {%- endfor -%}

    {%- else -%}
      <!-- Empty Cart State -->
      <div class="flex flex-col items-center justify-center py-16 space-y-4 text-center">
        <div class="w-16 h-16 rounded-full bg-[#FBF7F2] border border-[#E8DFD5] flex items-center justify-center">
          <svg class="w-7 h-7 text-[#A09587]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <h4 class="font-serif font-bold text-base text-[#191614]">Your Bag is Empty</h4>
        <p class="text-xs text-[#6B6259]">Add the Menvel Wooden Trivet Set to get started.</p>
        <a href="/products/foldable-wooden-trivet-set"
           class="inline-flex items-center gap-2 h-10 px-6 rounded-xl bg-[#3A2213] text-white text-xs font-bold uppercase tracking-wider hover:bg-[#2A170C] transition">
          Shop Now →
        </a>
      </div>
    {%- endif -%}

  </div>

  <!-- Footer: Subtotal + Checkout -->
  <div class="border-t border-[#EADFCF] bg-white p-5 space-y-3">
    <!-- Trust Badges -->
    <div class="flex items-center justify-center gap-4 text-[10px] text-[#8A7A6E] font-semibold pb-2 border-b border-[#F0E8DC]">
      <span class="flex items-center gap-1">🔒 256-Bit SSL</span>
      <span class="flex items-center gap-1">↩️ 30-Day Money Back</span>
    </div>

    <div class="flex items-center justify-between">
      <span class="text-sm font-bold text-[#1F1B17]">Subtotal</span>
      <span id="MenvelCartSubtotal" class="font-bold text-base text-[#1F1B17]">{{ cart.total_price | money }}</span>
    </div>

    <p class="text-[10px] text-center text-[#9CA3AF]">Shipping & taxes calculated at checkout.</p>

    <a href="/checkout"
       class="block w-full h-12 rounded-xl bg-black hover:bg-neutral-800 text-white font-black text-sm uppercase tracking-wider flex items-center justify-center gap-2 transition shadow-md cursor-pointer text-center">
      PROCEED TO CHECKOUT →
    </a>

    <a href="{{ routes.cart_url }}"
       class="block w-full h-10 rounded-xl border-2 border-[#3A2213] text-[#3A2213] hover:bg-[#FBF7F2] font-bold text-xs uppercase tracking-wider flex items-center justify-center transition text-center">
      View Full Cart
    </a>
  </div>

</aside>
